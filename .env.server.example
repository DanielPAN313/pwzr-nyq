# Copy this file to .env.server on the server. Never commit .env.server.
NODE_ENV=production
PORT=4174

# MySQL container settings used by docker-compose.yml.
MYSQL_DATABASE=nyq
MYSQL_USER=nyq
MYSQL_PASSWORD=replace_with_a_strong_app_password
MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password
MYSQL_PUBLIC_PORT=3306

# WeChat Mini Program login. Fill these after registration.
WECHAT_APP_ID=replace_with_wechat_mini_program_appid
WECHAT_APP_SECRET=replace_with_wechat_mini_program_appsecret

# WeChat Pay placeholders. Fill these before enabling real payments.
WECHAT_PAY_MCH_ID=replace_with_merchant_id
WECHAT_PAY_SERIAL_NO=replace_with_merchant_certificate_serial_no
WECHAT_PAY_API_V3_KEY=replace_with_api_v3_key
# Put the merchant private key on the server at ./secrets/wechat_pay_private_key.pem.
# docker-compose.yml mounts ./secrets into the container as /run/secrets:ro.
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat_pay_private_key.pem
# Optional after refund is enabled.
WECHAT_PAY_NOTIFY_URL=https://api.your-domain.com/api/sports-app/payment/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://api.your-domain.com/api/sports-app/payment/wechat/refund-notify

# Public HTTPS API endpoint that must be configured as a WeChat request domain.
PUBLIC_API_BASE_URL=https://api.your-domain.com

# Independent platform Web admin. The first account is created only when both
# values are set; use at least 12 random characters and rotate it after login.
PLATFORM_ADMIN_USERNAME=nyq-admin
PLATFORM_ADMIN_PASSWORD=replace_with_a_long_random_admin_password
ADMIN_WEB_ORIGIN=https://admin.your-domain.com

# The storage gateway validates the short-lived HMAC policy returned by
# POST /api/admin/v1/uploads/sign. Do not expose the signing secret to browsers.
OBJECT_STORAGE_UPLOAD_URL=https://upload.your-domain.com/v1/objects
OBJECT_STORAGE_PUBLIC_BASE_URL=https://cdn.your-domain.com
OBJECT_STORAGE_SIGNING_SECRET=replace_with_at_least_32_random_characters

# Production must keep development identity headers disabled.
NYQ_ALLOW_DEV_AUTH=false
NYQ_DEV_VENUE_BINDING=false

# MVP scheduler. Multi-instance execution is safe because refund rows are
# locked in a transaction before state changes.
NYQ_SCHEDULER_ENABLED=true
NYQ_JOB_POLL_INTERVAL_MS=60000
