page {
  min-height: 100vh;
  color: #f7fbf5;
  background: #07120d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

page::after {
  content: "";
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  height: 260rpx;
  background: linear-gradient(180deg, rgba(7, 18, 13, 0), rgba(7, 18, 13, 0.76) 42%, #07120d 100%);
  box-shadow: 0 -34rpx 70rpx rgba(0, 0, 0, 0.38);
  pointer-events: none;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 260rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 24rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(205, 255, 94, 0.1);
  border-radius: 26rpx;
  background: #101b15;
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.22);
  box-sizing: border-box;
}

.page-kicker {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  min-height: 38rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.page-title,
.card-title {
  display: block;
  color: #f7fbf5;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.22;
}

.page-title {
  margin-bottom: 10rpx;
}

.card-title {
  margin-bottom: 8rpx;
}

.muted {
  color: rgba(247, 251, 245, 0.62);
  font-size: 25rpx;
  line-height: 1.55;
}

.primary {
  color: #10200f;
  background: #d8ff3e;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  font: inherit;
  line-height: normal;
}

button::after {
  border: 0;
}

button[disabled] {
  color: rgba(247, 251, 245, 0.58);
  background: #38443d;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: rgba(247, 251, 245, 0.82);
  background: #17231c;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.pill.dark {
  color: #10200f;
  background: #d8ff3e;
}

.status-chip {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 44rpx;
}

.loading-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.loading-line,
.loading-card,
.loading-pill {
  position: relative;
  overflow: hidden;
  background: rgba(247, 251, 245, 0.08);
}

.loading-line::after,
.loading-card::after,
.loading-pill::after {
  content: "";
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(90deg, transparent, rgba(216, 255, 62, 0.18), transparent);
  animation: loading-shimmer 1.25s ease-in-out infinite;
}

.loading-line {
  height: 24rpx;
  border-radius: 999rpx;
}

.loading-line.lg {
  width: 68%;
}

.loading-line.md {
  width: 48%;
}

.loading-line.sm {
  width: 34%;
}

.loading-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.loading-card {
  height: 120rpx;
  border-radius: 18rpx;
}

.loading-pill {
  width: 140rpx;
  height: 42rpx;
  border-radius: 999rpx;
}

@keyframes loading-shimmer {
  100% {
    transform: translateX(100%);
  }
}
