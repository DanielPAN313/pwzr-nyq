page {
  min-height: 100vh;
  color: #f7fbf5;
  background: #07120d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 56rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 24rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.1);
  border-radius: 26rpx;
  background: #101b15;
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.22);
  box-sizing: border-box;
}

.page-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #13241a 0%, #0b3d27 52%, #0f8a4f 100%);
  border-radius: 34rpx;
  overflow: hidden;
}

.page-hero::after {
  content: "";
  position: absolute;
  right: -96rpx;
  top: -120rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 999rpx;
  background: radial-gradient(ellipse at center, rgba(216, 255, 62, 0.24) 0%, rgba(216, 255, 62, 0.1) 48%, rgba(216, 255, 62, 0) 74%);
}

.page-kicker {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  min-height: 38rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.page-title,
.section-title,
.card-title {
  position: relative;
  z-index: 1;
  display: block;
  color: #f7fbf5;
  font-weight: 900;
  line-height: 1.28;
}

.page-title {
  font-size: 38rpx;
}

.section-title,
.card-title {
  font-size: 30rpx;
}

.muted {
  position: relative;
  z-index: 1;
  color: rgba(247, 251, 245, 0.62);
  font-size: 25rpx;
  line-height: 1.55;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  font: inherit;
  line-height: normal;
}

button::after {
  border: 0;
}

button[disabled] {
  color: rgba(247, 251, 245, 0.5);
  background: #38443d;
  opacity: 0.68;
}

.primary,
.secondary,
.hero-action {
  border-radius: 999rpx;
  font-weight: 900;
}

.primary,
.hero-action {
  color: #10200f;
  background: #d8ff3e;
}

.secondary {
  color: #d8ff3e;
  background: #17231c;
}

.small {
  min-width: 150rpx;
  min-height: 62rpx;
  padding: 0 22rpx;
  font-size: 26rpx;
  line-height: 62rpx;
}

.state-panel {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.12);
  border-radius: 26rpx;
  background: #101b15;
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.18);
}

.state-panel.warning {
  border-color: rgba(240, 122, 50, 0.36);
  background: #1a1b13;
}

.state-panel.empty {
  background: #0d1711;
}

.state-title {
  color: #f7fbf5;
  font-size: 30rpx;
  font-weight: 900;
}

.state-text {
  color: rgba(247, 251, 245, 0.64);
  font-size: 26rpx;
  line-height: 1.5;
}

.state-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 8rpx;
}

.state-actions button {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  display: block;
  color: #d8ff3e;
  font-size: 24rpx;
  font-weight: 900;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  min-height: 118rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.1);
  border-radius: 22rpx;
  background: #101b15;
  box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}

.stat-success {
  border-color: rgba(216, 255, 62, 0.22);
}

.stat-info {
  border-color: rgba(68, 166, 214, 0.2);
}

.stat-warning {
  border-color: rgba(240, 122, 50, 0.26);
}

.stat-value {
  display: block;
  color: #d8ff3e;
  font-size: 34rpx;
  font-weight: 950;
}

.stat-label {
  display: block;
  margin-top: 6rpx;
  color: rgba(247, 251, 245, 0.6);
  font-size: 22rpx;
  line-height: 1.35;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.quick-card {
  min-height: 86rpx;
  border-radius: 22rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 28rpx;
  font-weight: 900;
}

.todo-card,
.recommend-row,
.message-section,
.menu-section,
.step-box {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.1);
  border-radius: 20rpx;
  background: #17231c;
}

.todo-card,
.recommend-row,
.section-head,
.message-title-row,
.message-footer,
.menu-main,
.order-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.todo-title,
.recommend-title,
.message-title,
.step-title {
  display: block;
  color: #f7fbf5;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.todo-text,
.recommend-meta,
.menu-hint,
.step-text,
.target-hint,
.notice-text {
  display: block;
  margin-top: 6rpx;
  color: rgba(247, 251, 245, 0.62);
  font-size: 24rpx;
  line-height: 1.5;
}

.action-text {
  flex-shrink: 0;
  color: #d8ff3e;
  font-size: 24rpx;
  font-weight: 900;
}

.search-input {
  width: 100%;
  min-height: 84rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.12);
  border-radius: 26rpx;
  background: #07120d;
  box-sizing: border-box;
  color: #f7fbf5;
  font-size: 26rpx;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.filter-chip,
.status,
.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: rgba(247, 251, 245, 0.78);
  background: #17231c;
  font-size: 23rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.filter-chip.active,
.filter-chip.is-active {
  color: #10200f;
  background: #d8ff3e;
}

.create-button {
  flex-shrink: 0;
  margin-top: 18rpx;
}

.section-count {
  color: rgba(247, 251, 245, 0.6);
  font-size: 23rpx;
  font-weight: 800;
}
