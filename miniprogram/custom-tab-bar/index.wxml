<view class="tab-safe">
  <view class="liquid-shell">
    <view
      wx:for="{{tabs}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-symbol tab-symbol-{{index}}">
        <view class="symbol-part part-a"></view>
        <view class="symbol-part part-b"></view>
        <view class="symbol-part part-c"></view>
        <view wx:if="{{index === 5 && showPendingDot}}" class="tab-dot"></view>
      </view>
      <text class="tab-label">{{item.text}}</text>
    </view>
  </view>
</view>
