<view class="tab-safe">
  <view class="liquid-shell">
    <view
      wx:for="{{tabs}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-symbol tab-symbol-{{index}}">
        <view class="symbol-part part-a"></view>
        <view class="symbol-part part-b"></view>
        <view class="symbol-part part-c"></view>
      </view>
    </view>
  </view>
</view>
