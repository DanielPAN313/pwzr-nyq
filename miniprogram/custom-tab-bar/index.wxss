.tab-safe {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 0 24rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  pointer-events: none;
}

.liquid-shell {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0;
  min-height: 112rpx;
  padding: 10rpx 10rpx;
  border-radius: 34rpx;
  background: #C8FF00;
  box-shadow: 0 18rpx 42rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
  pointer-events: auto;
}

.tab-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  height: 96rpx;
  border-radius: 24rpx;
  color: rgba(16, 32, 15, 0.54);
  transition: all 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.tab-item.active {
  flex: 1.08;
  color: #07120d;
}

.tab-symbol {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  color: currentColor;
  transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1), color 240ms ease;
}

.active .tab-symbol {
  color: #07120d;
  transform: scale(1.08);
}

.tab-label {
  display: block;
  margin-top: 4rpx;
  color: currentColor;
  font-size: 10px;
  font-weight: 850;
  line-height: 1;
}

.symbol-part {
  position: absolute;
  box-sizing: border-box;
}

.tab-symbol-0 .part-a {
  left: 7rpx;
  top: 20rpx;
  width: 34rpx;
  height: 22rpx;
  border-radius: 6rpx;
  background: currentColor;
}

.tab-symbol-0 .part-b {
  left: 10rpx;
  top: 8rpx;
  width: 28rpx;
  height: 28rpx;
  background: currentColor;
  transform: rotate(45deg);
}

.tab-symbol-0 .part-c {
  left: 20rpx;
  top: 28rpx;
  width: 8rpx;
  height: 14rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: #C8FF00;
}

.tab-symbol-1 .part-a {
  left: 5rpx;
  top: 8rpx;
  width: 38rpx;
  height: 32rpx;
  border: 5rpx solid currentColor;
  border-radius: 8rpx;
}

.tab-symbol-1 .part-b {
  left: 24rpx;
  top: 8rpx;
  width: 5rpx;
  height: 32rpx;
  background: currentColor;
}

.tab-symbol-1 .part-c {
  left: 10rpx;
  top: 22rpx;
  width: 28rpx;
  height: 5rpx;
  background: currentColor;
}

.tab-symbol-2 .part-a {
  left: 4rpx;
  top: 9rpx;
  width: 38rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
}

.tab-symbol-2 .part-b {
  left: 22rpx;
  top: 9rpx;
  width: 4rpx;
  height: 28rpx;
  background: currentColor;
}

.tab-symbol-2 .part-c {
  right: 3rpx;
  top: 4rpx;
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
  background: currentColor;
}

.tab-symbol-3 .part-a {
  left: 5rpx;
  top: 8rpx;
  width: 38rpx;
  height: 28rpx;
  border-radius: 11rpx;
  background: currentColor;
}

.tab-symbol-3 .part-b {
  left: 14rpx;
  top: 30rpx;
  width: 14rpx;
  height: 14rpx;
  background: currentColor;
  transform: skewX(-26deg);
}

.tab-symbol-3 .part-c {
  left: 14rpx;
  top: 20rpx;
  width: 20rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #C8FF00;
}

.tab-symbol-4 .part-a {
  left: 15rpx;
  top: 7rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: currentColor;
}

.tab-symbol-4 .part-b {
  left: 8rpx;
  top: 29rpx;
  width: 32rpx;
  height: 15rpx;
  border-radius: 16rpx 16rpx 5rpx 5rpx;
  background: currentColor;
}

.tab-symbol-4 .part-c {
  display: none;
}

.tab-dot {
  position: absolute;
  top: -1px;
  right: -1px;
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: #ff3b30;
}
