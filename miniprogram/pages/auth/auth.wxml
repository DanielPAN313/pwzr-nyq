<view class="page account-page">
  <view class="section account-hero">
    <view class="hero-court">
      <view class="auth-court-line"></view>
      <view class="auth-court-mid"></view>
      <view class="auth-court-ball"></view>
    </view>
    <view class="account-brand">
      <text class="brand-mark">宁</text>
      <view class="account-copy">
        <text class="page-kicker">NINGYUEQIU ACCOUNT</text>
        <text class="account-title">{{mode === 'register' ? '创建你的球局账户' : '登录 NYQ'}}</text>
        <text class="account-subtitle">订场、组局、订单、核销都会挂在同一个身份下。</text>
      </view>
    </view>
  </view>

  <view class="section auth-panel">
    <view class="auth-tabs">
      <button class="auth-tab {{mode === 'register' ? 'active' : ''}}" bindtap="switchMode" data-mode="register">创建账号</button>
      <button class="auth-tab {{mode === 'login' ? 'active' : ''}}" bindtap="switchMode" data-mode="login">登录账号</button>
    </view>

    <text class="auth-note">{{mode === 'register' ? '先用邮箱或用户名创建账号，后续服务器上线后可继续绑定微信登录。' : '使用已经创建的账号进入，订单和球局会写入同一份用户身份。'}}</text>

    <view class="field-group">
      <text class="field-label">邮箱</text>
      <input class="auth-input" type="text" value="{{form.email}}" placeholder="you@example.com" bindinput="onInput" data-field="email" />
    </view>

    <view class="field-group">
      <text class="field-label">用户名</text>
      <input class="auth-input" type="text" value="{{form.username}}" placeholder="例如 nyq_player" bindinput="onInput" data-field="username" />
    </view>

    <view class="field-group">
      <text class="field-label">密码</text>
      <input class="auth-input" password="{{true}}" value="{{form.password}}" placeholder="至少 6 位" bindinput="onInput" data-field="password" />
    </view>

    <view class="auth-actions">
      <button class="primary auth-button" bindtap="submitAuth" disabled="{{loading}}">{{mode === 'register' ? '创建账号' : '登录 NYQ'}}</button>
      <button class="secondary auth-secondary" bindtap="quickEnter" disabled="{{loading}}">演示快速进入</button>
    </view>

    <text wx:if="{{statusText}}" class="account-status">{{statusText}}</text>
  </view>

  <view class="section account-status-panel">
    <view class="status-row">
      <text class="status-label">当前身份</text>
      <text class="status-value">{{currentUser ? currentUser.nickName || currentUser.username : '未登录'}}</text>
    </view>
    <view class="account-links">
      <button class="link-button" bindtap="goHome">回首页</button>
      <button class="link-button" bindtap="logoutAccount" disabled="{{!currentUser}}">退出账号</button>
    </view>
  </view>
</view>
