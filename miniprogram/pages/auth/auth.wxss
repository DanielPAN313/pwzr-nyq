.account-page {
  background: #07120d;
}

.account-hero {
  position: relative;
  min-height: 470rpx;
  padding: 28rpx;
  border-color: rgba(216, 255, 62, 0.14);
  background: linear-gradient(145deg, #10231a 0%, #0b3d27 52%, #12824f 100%);
  overflow: hidden;
}

.hero-court {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 38rpx;
  height: 300rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.36);
  border-radius: 32rpx;
}

.hero-court::before,
.hero-court::after,
.auth-court-line,
.auth-court-mid {
  content: "";
  position: absolute;
  background: rgba(255, 255, 255, 0.38);
}

.hero-court::before {
  left: 50%;
  top: 0;
  bottom: 0;
  width: 3rpx;
}

.hero-court::after {
  left: 0;
  right: 0;
  top: 50%;
  height: 3rpx;
}

.auth-court-line {
  left: 58rpx;
  right: 58rpx;
  top: 78rpx;
  height: 3rpx;
}

.auth-court-mid {
  left: 58rpx;
  right: 58rpx;
  bottom: 78rpx;
  height: 3rpx;
  background: #d8ff3e;
  box-shadow: 0 0 28rpx rgba(216, 255, 62, 0.42);
}

.auth-court-ball {
  position: absolute;
  right: 86rpx;
  top: 96rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 999rpx;
  background: #d8ff3e;
  box-shadow: 0 0 0 14rpx rgba(216, 255, 62, 0.16);
}

.account-brand {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  gap: 22rpx;
  min-height: 400rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 116rpx;
  height: 116rpx;
  border-radius: 32rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 50rpx;
  font-weight: 950;
  box-shadow: 0 26rpx 64rpx rgba(216, 255, 62, 0.2);
}

.account-copy {
  flex: 1;
  min-width: 0;
}

.account-title {
  display: block;
  margin-top: 16rpx;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 950;
  line-height: 1.12;
}

.account-subtitle {
  display: block;
  margin-top: 12rpx;
  color: rgba(247, 251, 245, 0.72);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.55;
}

.auth-panel {
  padding: 24rpx;
}

.auth-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.auth-tab {
  min-height: 72rpx;
  border-radius: 999rpx;
  color: rgba(247, 251, 245, 0.72);
  background: #17231c;
  font-size: 26rpx;
  font-weight: 900;
}

.auth-tab.active {
  color: #10200f;
  background: #d8ff3e;
}

.auth-note {
  display: block;
  color: rgba(247, 251, 245, 0.62);
  font-size: 24rpx;
  line-height: 1.55;
}

.field-group {
  margin-top: 22rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: rgba(247, 251, 245, 0.78);
  font-size: 24rpx;
  font-weight: 900;
}

.auth-input {
  min-height: 86rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.14);
  border-radius: 24rpx;
  color: #f7fbf5;
  background: #07120d;
  font-size: 27rpx;
  box-sizing: border-box;
}

.auth-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-top: 26rpx;
}

.auth-button,
.auth-secondary {
  min-height: 82rpx;
  font-size: 28rpx;
  line-height: 82rpx;
}

.account-status {
  display: block;
  margin-top: 18rpx;
  color: #d8ff3e;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.5;
}

.account-status-panel {
  padding: 22rpx;
}

.status-row,
.account-links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.status-label {
  color: rgba(247, 251, 245, 0.62);
  font-size: 24rpx;
  font-weight: 800;
}

.status-value {
  color: #f7fbf5;
  font-size: 26rpx;
  font-weight: 900;
  text-align: right;
}

.account-links {
  margin-top: 18rpx;
}

.link-button {
  flex: 1;
  min-height: 68rpx;
  border-radius: 999rpx;
  color: #d8ff3e;
  background: #17231c;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 68rpx;
}
