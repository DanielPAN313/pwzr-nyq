.credit-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 36rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #10231a 0%, #0b3d27 52%, #12824f 100%);
  box-shadow: 0 28rpx 64rpx rgba(16, 32, 22, 0.2);
  overflow: hidden;
}

.credit-hero::after {
  content: "";
  position: absolute;
  right: -92rpx;
  top: -112rpx;
  width: 300rpx;
  height: 230rpx;
  border-radius: 999rpx;
  background: radial-gradient(ellipse at center, rgba(216, 255, 62, 0.22) 0%, rgba(216, 255, 62, 0.1) 48%, rgba(216, 255, 62, 0) 74%);
  pointer-events: none;
}

.credit-hero.good {
  background: linear-gradient(145deg, #10231a 0%, #0b6b42 54%, #12824f 100%);
}

.credit-hero.warning {
  background: linear-gradient(145deg, #33260d 0%, #8a5a00 58%, #b97803 100%);
}

.credit-hero.danger {
  background: linear-gradient(145deg, #351414 0%, #8f2f2f 58%, #b84444 100%);
}

.hero-label,
.hero-hint {
  position: relative;
  z-index: 1;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  line-height: 1.5;
}

.score {
  position: relative;
  z-index: 1;
  font-size: 78rpx;
  font-weight: 950;
  line-height: 1;
}

.score-track {
  position: relative;
  z-index: 1;
  height: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
}

.score-fill {
  height: 100%;
  border-radius: inherit;
  background: #ffffff;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.metric {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-height: 132rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(219, 228, 216, 0.95);
  border-radius: 18rpx;
  background: #fbfdf9;
  box-sizing: border-box;
}

.metric-value {
  color: #102016;
  font-size: 36rpx;
  font-weight: 950;
  line-height: 1.15;
}

.metric-hint {
  color: #7a847d;
  font-size: 22rpx;
  line-height: 1.35;
}

.section-title {
  display: block;
  margin-bottom: 18rpx;
  color: #102016;
  font-size: 31rpx;
  font-weight: 950;
  line-height: 1.35;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.action-row button {
  flex: 1;
}

.secondary {
  color: #12824f;
  background: #eef6ed;
}

.tip-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 14rpx 0;
}

.tip-index {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  background: #12824f;
}

.tip-text {
  flex: 1;
  color: #334138;
  font-size: 26rpx;
  line-height: 1.5;
}

.rule-card {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(219, 228, 216, 0.9);
}

.rule-card:last-child {
  border-bottom: 0;
}

.event-section {
  margin-top: 8rpx;
}

.event-section-title {
  display: block;
  margin: 18rpx 0 8rpx;
  color: #5c6a61;
  font-size: 25rpx;
  font-weight: 850;
}

.credit-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 104rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(219, 228, 216, 0.9);
  box-sizing: border-box;
}

.credit-row:last-child {
  border-bottom: 0;
}

.event-title {
  display: block;
  margin-bottom: 6rpx;
  color: #102016;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.score-delta {
  flex-shrink: 0;
  color: #12824f;
  font-size: 32rpx;
  font-weight: 950;
  line-height: 1.2;
}

.score-delta.negative {
  color: #b93b3b;
}

.score-delta.neutral {
  color: #7a847d;
}

@media (max-width: 360px) {
  .metric-grid {
    grid-template-columns: 1fr;
  }
}

.section-title,
.event-title {
  color: #f7fbf5;
}

.metric,
.rule-card,
.credit-row {
  border-color: rgba(216, 255, 62, 0.12);
  background: #17231c;
}

.metric-value,
.tip-text {
  color: #f7fbf5;
}

.metric-hint,
.event-section-title {
  color: rgba(247, 251, 245, 0.62);
}

.rule-card,
.credit-row {
  border-bottom-color: rgba(216, 255, 62, 0.1);
}
