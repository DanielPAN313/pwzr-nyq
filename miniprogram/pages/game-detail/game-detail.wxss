.section:first-child {
  position: relative;
  padding: 30rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #10231a 0%, #0b3d27 52%, #12824f 100%);
  box-shadow: 0 28rpx 64rpx rgba(16, 32, 22, 0.2);
  overflow: hidden;
}

.section:first-child::after {
  content: "";
  position: absolute;
  right: -92rpx;
  top: -112rpx;
  width: 290rpx;
  height: 220rpx;
  border-radius: 999rpx;
  background: radial-gradient(ellipse at center, rgba(216, 255, 62, 0.22) 0%, rgba(216, 255, 62, 0.1) 48%, rgba(216, 255, 62, 0) 74%);
}

.page-title {
  position: relative;
  z-index: 1;
  display: block;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.2;
}

.section:first-child .muted {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 12rpx;
  color: rgba(247, 251, 245, 0.76);
  font-size: 25rpx;
  line-height: 1.5;
}

.section-title {
  display: block;
  margin-bottom: 18rpx;
  color: #102016;
  font-size: 31rpx;
  font-weight: 950;
  line-height: 1.35;
}

.detail-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 36rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #10231a 0%, #0b3d27 48%, #12824f 100%);
  box-shadow: 0 28rpx 64rpx rgba(16, 32, 22, 0.18);
  overflow: hidden;
}

.detail-hero::after {
  content: "";
  position: absolute;
  right: -92rpx;
  bottom: -110rpx;
  width: 310rpx;
  height: 230rpx;
  border-radius: 999rpx;
  background: radial-gradient(ellipse at center, rgba(216, 255, 62, 0.2) 0%, rgba(216, 255, 62, 0.08) 48%, rgba(216, 255, 62, 0) 74%);
  pointer-events: none;
}

.detail-title {
  position: relative;
  z-index: 1;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.18;
}

.detail-status {
  position: relative;
  z-index: 1;
  align-self: flex-start;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #083923;
  background: #d7f36a;
  font-size: 24rpx;
  font-weight: 850;
}

.status-warning {
  background: #fed7aa;
  color: #9a3412;
}

.status-info {
  background: #bfdbfe;
  color: #1d4ed8;
}

.status-success {
  background: #bbf7d0;
  color: #067647;
}

.status-muted {
  background: #e2e8f0;
  color: #475569;
}

.detail-muted {
  position: relative;
  z-index: 1;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  line-height: 1.45;
}

.step-panel {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  border-left: 6rpx solid #94a3b8;
  background: #fbfdf9;
}

.step-warning {
  border-left-color: #f97316;
  background: #fff7ed;
}

.step-info {
  border-left-color: #3b82f6;
  background: #eff6ff;
}

.step-success {
  border-left-color: #12b76a;
  background: #ecfdf3;
}

.step-muted {
  border-left-color: #94a3b8;
  background: #f1f5f9;
}

.step-title {
  color: #102016;
  font-size: 30rpx;
  font-weight: 900;
}

.step-text {
  color: #6f7c72;
  font-size: 24rpx;
  line-height: 1.5;
}

.signup-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-color: rgba(216, 255, 62, 0.18);
  background: #101b15;
}

.signup-panel > view {
  flex: 1;
  min-width: 0;
}

.signup-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 218rpx;
  min-height: 78rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 28rpx;
  font-weight: 950;
  line-height: 78rpx;
  text-align: center;
  box-sizing: border-box;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-height: 116rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(219, 228, 216, 0.95);
  border-radius: 18rpx;
  background: #fbfdf9;
  box-sizing: border-box;
}

.info-value {
  color: #102016;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.25;
  word-break: break-all;
}

.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.progress-value {
  color: #102016;
  font-size: 36rpx;
  font-weight: 950;
  line-height: 1.15;
}

.progress-missing {
  flex-shrink: 0;
  color: #12824f;
  font-size: 26rpx;
  font-weight: 900;
  text-align: right;
}

.progress-track {
  overflow: hidden;
  height: 18rpx;
  border-radius: 999rpx;
  background: #eef2ec;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #12824f 0%, #12b76a 100%);
}

.player-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 96rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(219, 228, 216, 0.9);
  box-sizing: border-box;
}

.player-row:last-child {
  border-bottom: 0;
}

.player-name {
  display: block;
  margin-bottom: 6rpx;
  color: #102016;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.player-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #12824f;
  background: #eef6ed;
  font-size: 24rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.review-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.review-panel button {
  min-height: 82rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.player-tags {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.review-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  color: #6f7c72;
  background: #eef2ec;
  font-size: 22rpx;
  font-weight: 850;
  box-sizing: border-box;
}

.section-title,
.step-title,
.progress-value,
.player-name {
  color: #f7fbf5;
}

.step-text {
  color: rgba(247, 251, 245, 0.62);
}

.step-panel,
.info-item,
.player-status {
  border-color: rgba(216, 255, 62, 0.12);
  background: #17231c;
}

.step-warning,
.step-info,
.step-success,
.step-muted {
  background: #17231c;
}

.info-value {
  color: #d8ff3e;
}

.player-row {
  border-bottom-color: rgba(216, 255, 62, 0.1);
}

.progress-track {
  background: #334139;
}
