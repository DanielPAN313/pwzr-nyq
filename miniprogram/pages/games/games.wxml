<view class="page">
  <view class="section page-hero">
    <text class="page-kicker">OPEN MATCHES</text>
    <view class="page-title">附近球局</view>
    <text wx:if="{{loading}}" class="muted">正在加载球局...</text>
    <text wx:elif="{{empty}}" class="muted">暂时没有可报名球局。</text>
    <text wx:else class="muted">找球局、发起球局、球队和我的球局都在这里。</text>
    <view class="filter-row">
      <text class="pill dark">可报名</text>
      <text class="pill">今晚</text>
      <text class="pill">离我近</text>
    </view>
    <view class="hub-actions">
      <button class="hub-action primary-action {{access.createBlockedByCredit ? 'credit-disabled' : ''}}" bindtap="createGame">
        <text class="hub-action-title">发起球局</text>
        <text class="hub-action-sub">{{access.createBlockedByCredit ? '信用分需达到 80' : '约人开一场'}}</text>
      </button>
      <button class="hub-action" bindtap="goTeams">
        <text class="hub-action-title">球队</text>
        <text class="hub-action-sub">固定队伍</text>
      </button>
      <button class="hub-action" bindtap="goMyGames">
        <text class="hub-action-title">我的球局</text>
        <text class="hub-action-sub">报名/发起</text>
      </button>
      <button class="hub-action" bindtap="goRankings">
        <text class="hub-action-title">排行</text>
        <text class="hub-action-sub">出勤榜</text>
      </button>
    </view>
  </view>

  <view class="search-panel">
    <view class="search-mark"></view>
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜索球局、场地或状态"
      placeholder-class="search-placeholder"
      confirm-type="search"
      bindinput="onSearchInput"
    />
    <button wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">×</button>
  </view>

  <view class="result-line">
    <text>{{games.length}} 场可查看</text>
    <text wx:if="{{keyword}}"> · 已筛选“{{keyword}}”</text>
  </view>

  <view wx:if="{{empty}}" class="section empty-card">
    <text class="card-title">没有找到匹配球局</text>
    <text class="muted">换个关键词，或者去场馆页先订一个场。</text>
  </view>

  <view wx:for="{{games}}" wx:key="title" class="section game-card">
    <view class="game-thumb" bindtap="openGameDetail" data-id="{{item.id}}">
      <view class="thumb-line thumb-line-a"></view>
      <view class="thumb-line thumb-line-b"></view>
      <view class="thumb-ball"></view>
    </view>
    <view class="game-body">
      <view class="game-top-row">
        <view class="game-heading">
          <text class="game-type game-type-{{item.typeTone}}">{{item.typeText}}</text>
          <text class="card-title game-title">{{item.title}}</text>
        </view>
        <text class="status-chip">{{item.status}}</text>
      </view>
      <text class="game-line">发起人 · {{item.time}}</text>
      <text class="game-line">{{item.venueName}} · {{item.mode}} · {{item.fee}}</text>
      <view class="match-meta">
        <text class="meta-item">AA</text>
        <text class="meta-item">到场核销</text>
      </view>
      <view class="game-actions">
        <button
          class="secondary small detail-button"
          bindtap="openGameDetail"
          data-id="{{item.id}}"
        >
          详情
        </button>
        <button
          class="primary small join-button {{item.creditBlocked || item.profileBlocked ? 'credit-disabled' : ''}}"
          bindtap="openGame"
          data-id="{{item.id}}"
          disabled="{{joiningId === item.id && item.id}}"
        >
          {{joiningId === item.id && item.id ? "报名中" : item.actionText}}
        </button>
      </view>
      <view class="invite-actions">
        <button class="invite-share" open-type="share" data-id="{{item.id}}">邀请好友</button>
        <text class="invite-copy" data-id="{{item.id}}" bindtap="copyInvitePath">复制邀请路径</text>
      </view>
    </view>
  </view>
</view>
