.section:first-child {
  position: relative;
  padding: 30rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #10231a 0%, #0b3d27 52%, #12824f 100%);
  box-shadow: 0 28rpx 64rpx rgba(16, 32, 22, 0.2);
  overflow: hidden;
}

.section:first-child::after {
  content: "";
  position: absolute;
  right: -90rpx;
  top: -108rpx;
  width: 280rpx;
  height: 220rpx;
  border-radius: 999rpx;
  background: radial-gradient(ellipse at center, rgba(216, 255, 62, 0.24) 0%, rgba(216, 255, 62, 0.1) 48%, rgba(216, 255, 62, 0) 74%);
}

.page-title {
  position: relative;
  z-index: 1;
  display: block;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.2;
}

.section:first-child .muted {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 12rpx;
  color: rgba(247, 251, 245, 0.76);
  font-size: 25rpx;
  line-height: 1.5;
}

.search-input {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  color: #102016;
  background: rgba(255, 255, 255, 0.96);
}

.filter-row {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.filter-chip {
  border: 0;
  color: rgba(247, 251, 245, 0.86);
  background: rgba(255, 255, 255, 0.12);
}

.filter-chip.is-active {
  color: #10200f;
  background: #d8ff3e;
}

.create-button {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  color: #10200f;
  background: #d8ff3e;
}

.game-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  box-shadow: 0 18rpx 44rpx rgba(16, 32, 22, 0.08);
  overflow: hidden;
}

.game-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: #f07a32;
}

.game-card .card-title {
  padding-left: 4rpx;
}

.game-card .muted {
  line-height: 1.45;
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 12rpx;
}

.status {
  flex-shrink: 1;
  min-width: 0;
  color: #f07a32;
  background: #fff4eb;
}

.game-card .small {
  flex-shrink: 0;
}
