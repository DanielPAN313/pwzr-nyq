.page-hero {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #13241a, #0b3d27 52%, #0f8a4f);
  border-radius: 34rpx;
}

.page-hero .page-title {
  color: #ffffff;
  margin-bottom: 0;
}

.page-hero .muted {
  color: rgba(255, 255, 255, 0.76);
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.create-button {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  min-width: 176rpx;
  min-height: 68rpx;
  margin-top: 4rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 26rpx;
  font-weight: 950;
  line-height: 68rpx;
}

.hub-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 4rpx;
}

.hub-action {
  display: flex;
  min-width: 0;
  min-height: 96rpx;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  color: #FFFFFF;
  background: rgba(16, 27, 21, 0.82);
  box-shadow: inset 0 0 0 1rpx rgba(200, 255, 0, 0.12);
  box-sizing: border-box;
}

.hub-action.primary-action {
  color: #10200f;
  background: #C8FF00;
}

.hub-action-title {
  color: currentColor;
  font-size: 25rpx;
  font-weight: 950;
  line-height: 1.2;
}

.hub-action-sub {
  margin-top: 6rpx;
  color: rgba(247, 251, 245, 0.62);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
}

.primary-action .hub-action-sub {
  color: rgba(16, 32, 15, 0.66);
}

.search-panel {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 84rpx;
  margin-bottom: 14rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.14);
  border-radius: 999rpx;
  background: #101b15;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
  box-sizing: border-box;
}

.search-mark {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border: 5rpx solid #d8ff3e;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-mark::after {
  content: "";
  position: absolute;
  right: -10rpx;
  bottom: -7rpx;
  width: 14rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #d8ff3e;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  color: #f7fbf5;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.search-placeholder {
  color: #666666;
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  min-height: 48rpx;
  border-radius: 50%;
  color: #10200f;
  background: #d8ff3e;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.result-line {
  min-height: 40rpx;
  margin: 0 8rpx 18rpx;
  color: rgba(247, 251, 245, 0.58);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.empty-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  border-style: dashed;
  background: #101b15;
}

.game-card {
  display: flex;
  flex-direction: row;
  gap: 12px;
  align-items: flex-start;
  padding: 16px;
  border-color: rgba(216, 255, 62, 0.1);
  border-radius: 20px;
  background: #101b15;
  animation: rise-in 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.game-card:nth-child(3) {
  animation-delay: 60ms;
}

.game-card:nth-child(4) {
  animation-delay: 110ms;
}

.match-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.game-thumb {
  position: relative;
  flex-shrink: 0;
  width: 80px;
  height: 80px;
  border-radius: 12px;
  background: linear-gradient(145deg, #123025 0%, #0f5f3a 58%, #1a5c3a 100%);
  overflow: hidden;
}

.game-thumb::before {
  content: "";
  position: absolute;
  inset: 12px;
  border: 2px solid rgba(255, 255, 255, 0.45);
  border-radius: 10px;
}

.thumb-line {
  position: absolute;
  left: 12px;
  right: 12px;
  height: 2px;
  background: rgba(255, 255, 255, 0.38);
}

.thumb-line-a {
  top: 26px;
}

.thumb-line-b {
  bottom: 20px;
}

.thumb-ball {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #C8FF00;
}

.game-body {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 8px;
}

.game-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.game-heading {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
}

.game-type {
  padding: 3px 7px;
  border-radius: 4px;
  color: #ffffff;
  font-size: 11px;
  font-weight: 900;
  line-height: 1.2;
}

.game-type-casual {
  background: #4a90d9;
}

.game-type-event {
  background: #ff9800;
}

.game-title {
  flex: 1;
  min-width: 0;
}

.game-line {
  display: block;
  color: rgba(247, 251, 245, 0.72);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.4;
}

.match-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meta-item {
  padding: 0;
  border-radius: 0;
  color: #999999;
  background: transparent;
  font-size: 11px;
  font-weight: 800;
  line-height: 1.2;
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.game-actions {
  display: flex;
  flex-shrink: 0;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 4px;
}

.players {
  display: flex;
  align-items: center;
  min-width: 0;
}

.player-dot {
  width: 36rpx;
  height: 36rpx;
  margin-right: -10rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  background: #0f8a4f;
}

.player-dot:nth-child(2) {
  background: #d8ff3e;
}

.player-dot.empty {
  background: #334139;
}

.players-text {
  margin-left: 22rpx;
  color: #d8ff3e;
  font-size: 26rpx;
  font-weight: 900;
  white-space: nowrap;
}

.small {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 0;
  min-height: 36px;
  height: 36px;
  padding: 0 16px;
  border-radius: 999px;
  color: #C8FF00;
  background: #1A5C3A;
  font-size: 14px;
  font-weight: 900;
  line-height: 36px;
  text-align: center;
  box-sizing: border-box;
}

.join-button {
  flex-shrink: 0;
}

.invite-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 9px;
}

.invite-share {
  min-height: 30px;
  margin: 0;
  padding: 0 12px;
  border: 1px solid rgba(216, 255, 62, 0.32);
  border-radius: 6px;
  background: #17231c;
  color: #d8ff3e;
  font-size: 11px;
  line-height: 30px;
}

.invite-copy {
  color: rgba(247, 251, 245, 0.68);
  font-size: 11px;
  line-height: 30px;
}

.secondary.small {
  color: #999999;
  background: #17231c;
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(26rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
