.page-hero {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #13241a, #0b3d27 52%, #0f8a4f);
  border-radius: 34rpx;
}

.page-hero .page-title {
  color: #ffffff;
  margin-bottom: 0;
}

.page-hero .muted {
  color: rgba(255, 255, 255, 0.76);
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.create-button {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  min-width: 176rpx;
  min-height: 68rpx;
  margin-top: 4rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 26rpx;
  font-weight: 950;
  line-height: 68rpx;
}

.search-panel {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 84rpx;
  margin-bottom: 14rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.14);
  border-radius: 999rpx;
  background: #101b15;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
  box-sizing: border-box;
}

.search-mark {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border: 5rpx solid #d8ff3e;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-mark::after {
  content: "";
  position: absolute;
  right: -10rpx;
  bottom: -7rpx;
  width: 14rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #d8ff3e;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  color: #f7fbf5;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.search-placeholder {
  color: rgba(247, 251, 245, 0.42);
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  min-height: 48rpx;
  border-radius: 50%;
  color: #10200f;
  background: #d8ff3e;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.result-line {
  min-height: 40rpx;
  margin: 0 8rpx 18rpx;
  color: rgba(247, 251, 245, 0.58);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.empty-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  border-style: dashed;
  background: #101b15;
}

.game-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  border-color: rgba(216, 255, 62, 0.1);
  border-radius: 30rpx;
  background: #101b15;
  animation: rise-in 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.game-card:nth-child(3) {
  animation-delay: 60ms;
}

.game-card:nth-child(4) {
  animation-delay: 110ms;
}

.match-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.match-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meta-item {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: rgba(247, 251, 245, 0.78);
  background: #17231c;
  font-size: 23rpx;
  font-weight: 800;
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.game-actions {
  display: flex;
  flex-shrink: 0;
  gap: 12rpx;
}

.players {
  display: flex;
  align-items: center;
  min-width: 0;
}

.player-dot {
  width: 36rpx;
  height: 36rpx;
  margin-right: -10rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  background: #0f8a4f;
}

.player-dot:nth-child(2) {
  background: #d8ff3e;
}

.player-dot.empty {
  background: #334139;
}

.players-text {
  margin-left: 22rpx;
  color: #d8ff3e;
  font-size: 26rpx;
  font-weight: 900;
  white-space: nowrap;
}

.small {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 154rpx;
  min-height: 72rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 72rpx;
  text-align: center;
  box-sizing: border-box;
}

.join-button {
  flex-shrink: 0;
}

.secondary.small {
  color: rgba(247, 251, 245, 0.86);
  background: #17231c;
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(26rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
