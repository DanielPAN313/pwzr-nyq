<view class="page">
  <view class="topbar">
    <view>
      <text class="location">南京 · Jiangning</text>
    </view>
  </view>

  <view class="hero">
    <view class="court-panel">
      <view class="court-glow"></view>
      <view class="court-line court-line-top"></view>
      <view class="court-net"></view>
      <view class="court-line court-line-bottom"></view>
      <view class="court-ball"></view>
      <view class="court-copy">
        <text class="page-kicker">南京样板区</text>
        <text class="title">Book your court</text>
        <text class="subtitle">订场、组局、报名、核销，一次完成。</text>
      </view>
    </view>
  </view>

  <view class="quick-grid">
    <button
      wx:for="{{quickActions}}"
      wx:key="label"
      class="quick-action"
      bindtap="openQuickAction"
      data-target="{{item.target}}"
      data-mode="{{item.mode}}"
    >
      <text class="quick-label">{{item.label}}</text>
      <text class="quick-hint">{{item.hint}}</text>
    </button>
  </view>

  <view class="home-tabs">
    <view class="tab-highlight tab-highlight-{{homePanel}} {{tabMotionClass}}"></view>
    <button
      wx:for="{{homePanels}}"
      wx:key="label"
      class="home-tab {{homePanel == index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="switchHomePanel"
    >
      <text>{{item.label}}</text>
    </button>
  </view>

  <view class="panel-viewport {{panelMotionClass}}">
    <view class="panel-track" style="transform: {{panelTransform}};">
      <view class="panel-page">
        <view class="section feature-card">
          <view class="feature-head">
            <view>
              <text class="page-title">好友邀请</text>
              <text class="muted">好友发来的私密组局，确认后直接锁位</text>
            </view>
            <text class="pill dark">NEW</text>
          </view>
          <view class="sample-stack">
            <view wx:for="{{invitationGames}}" wx:key="id" class="game-sample-card {{item.featured ? 'featured' : ''}}">
              <view class="priority-badge">
                <text class="countdown-label">倒计时</text>
                <text class="countdown-value">{{item.countdownText}}</text>
                <text class="slots-left">{{item.slotsText}}</text>
              </view>
              <view class="game-court basketball"></view>
              <view class="game-info">
                <view class="sample-top">
                  <text class="card-title">{{item.title}}</text>
                </view>
                <text class="muted">{{item.desc}}</text>
                <view class="match-meta">
                  <text class="meta-item">{{item.venue}}</text>
                  <text class="meta-item">{{item.mode}}</text>
                  <text class="meta-item">{{item.fee}}</text>
                </view>
                <view class="venue-bottom">
                  <button class="book-button" bindtap="switchTab" data-target="/pages/games/games">{{item.actionText}}</button>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="panel-page">
        <view class="section feature-card">
          <view class="feature-head">
            <view>
              <text class="page-title">正在招人</text>
              <text class="muted">附近还缺人的公开球局，报名即可锁位</text>
            </view>
          </view>
          <view class="sample-stack">
            <view wx:for="{{recruitingGames}}" wx:key="id" class="game-sample-card {{item.featured ? 'featured' : ''}}">
              <view class="priority-badge">
                <text class="countdown-label">倒计时</text>
                <text class="countdown-value">{{item.countdownText}}</text>
                <text class="slots-left">{{item.slotsText}}</text>
              </view>
              <view class="game-court basketball"></view>
              <view class="game-info">
                <view class="sample-top">
                  <text class="card-title">{{item.title}}</text>
                </view>
                <text class="muted">{{item.desc}}</text>
                <view class="match-meta">
                  <text class="meta-item">{{item.venue}}</text>
                  <text class="meta-item">{{item.mode}}</text>
                  <text class="meta-item">{{item.fee}}</text>
                </view>
                <view class="venue-bottom">
                  <button class="book-button" bindtap="switchTab" data-target="/pages/games/games">{{item.actionText}}</button>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

    </view>
  </view>
</view>
