<view class="page home-page">
  <view class="topbar">
    <view>
      <text class="location">南京 · Jiangning</text>
      <text class="topbar-subtitle">宁约球运动地图</text>
    </view>
    <text class="pill dark">LIVE</text>
  </view>

  <view class="search-bar" bindtap="switchTab" data-target="/pages/venues/venues">
    <text class="search-icon">⌕</text>
    <text class="search-text">搜索场馆、球局、运动类型</text>
    <text class="search-filter">筛选</text>
  </view>

  <view class="hero">
    <view class="court-panel">
      <view class="court-glow"></view>
      <view class="court-line court-line-top"></view>
      <view class="court-net"></view>
      <view class="court-line court-line-bottom"></view>
      <view class="court-ball"></view>
      <view class="court-copy">
        <text class="page-kicker">南京样板区</text>
        <text class="title">Book your court</text>
        <text class="subtitle">订场、组局、报名、核销，一次完成。</text>
      </view>
    </view>
  </view>

  <view class="date-strip">
    <text class="date-pill active">今天</text>
    <text class="date-pill">明天</text>
    <text class="date-pill">周末</text>
    <text class="date-pill">附近</text>
  </view>

  <view class="section feature-card match-hub">
    <view class="match-tabs">
      <button
        wx:for="{{homeModes}}"
        wx:key="value"
        class="match-tab {{homeMode === item.value ? 'active' : ''}}"
        bindtap="switchHomeMode"
        data-mode="{{item.value}}"
      >
        {{item.label}}
      </button>
    </view>
    <text wx:if="{{loading}}" class="muted">正在匹配附近球局...</text>
    <view wx:elif="{{matchCards.length === 0}}" class="state-panel empty">
      <text class="state-title">暂时没有可加入球局</text>
      <text class="state-text">可以先发起一场，把时间、场馆和人数填好后邀请球友。</text>
      <view class="state-actions">
        <button class="primary small" bindtap="createGame">发起球局</button>
        <button class="secondary small" bindtap="switchTab" data-target="/pages/games/games">看全部</button>
      </view>
    </view>
    <view
      wx:for="{{matchCards}}"
      wx:key="id"
      class="match-card"
      bindtap="openTarget"
      data-target="{{item.target}}"
    >
      <view class="match-thumb">
        <view class="match-thumb-court"></view>
        <text class="match-sport">{{item.sport}}</text>
      </view>
      <view class="match-main">
        <view class="match-title-row">
          <view>
            <text class="match-title">{{item.title}}</text>
            <text class="match-format">{{item.format}} · {{item.missingText}}</text>
          </view>
          <text class="match-badge">{{item.badge}}</text>
        </view>
        <view class="countdown-pill">{{item.countdown}}</view>
        <view class="match-row" wx:for="{{item.rows}}" wx:for-item="row" wx:key="label">
          <text class="match-row-label">{{row.label}}</text>
          <text class="match-row-value">{{row.value}}</text>
        </view>
        <view class="match-footer">
          <text class="match-fee">{{item.feeText}}</text>
          <text class="match-action">{{item.actionText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="stat-grid">
    <view wx:for="{{statCards}}" wx:key="label" class="stat-card stat-{{item.tone}}">
      <text class="stat-value">{{item.value}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>

  <view class="section feature-card">
    <view class="feature-head">
      <view>
        <text class="page-title">常用入口</text>
        <text class="muted">快速进入订场、球局和订单</text>
      </view>
      <text class="pill dark">GO</text>
    </view>
    <view class="quick-grid">
      <button
        wx:for="{{quickActions}}"
        wx:key="label"
        class="quick-card"
        bindtap="switchTab"
        data-target="{{item.target}}"
      >
        {{item.label}}
      </button>
    </view>
  </view>

  <view class="section feature-card">
    <view class="feature-head">
      <view>
        <text class="page-title">待处理事项</text>
        <text class="muted">支付、核销、评价都会在这里提醒</text>
      </view>
      <text class="pill">TODO</text>
    </view>
    <text wx:if="{{loading}}" class="muted">正在加载首页数据...</text>
    <text wx:elif="{{error}}" class="muted">{{error}}，已显示本地兜底内容。</text>
    <text wx:elif="{{todoItems.length === 0}}" class="muted">暂无待处理事项，可以去找球局或订场。</text>
    <view
      wx:for="{{todoItems}}"
      wx:key="title"
      class="todo-card"
      bindtap="openTarget"
      data-target="{{item.target}}"
      data-tab="{{item.tab}}"
    >
      <view>
        <text class="todo-title">{{item.title}}</text>
        <text class="todo-text">{{item.text}}</text>
      </view>
      <text class="action-text">{{item.actionText}}</text>
    </view>
  </view>

  <view class="section feature-card">
    <view class="feature-head">
      <view>
        <text class="page-title">推荐场馆</text>
        <text class="muted">热门场地和黄金时段</text>
      </view>
      <text class="pill">COURT</text>
    </view>
    <text wx:if="{{recommendedVenues.length === 0}}" class="muted">暂无推荐场馆。</text>
    <view
      wx:for="{{recommendedVenues}}"
      wx:key="id"
      class="venue-card"
      bindtap="openTarget"
      data-target="{{item.target}}"
    >
      <view class="venue-image">
        <view class="mini-court"></view>
      </view>
      <view class="venue-info">
        <text class="card-title">{{item.name}}</text>
        <text class="muted">{{item.meta}}</text>
        <view class="venue-bottom">
          <text class="price">可订</text>
          <text class="action-text">查看</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section feature-card">
    <view class="feature-head">
      <view>
        <text class="page-title">推荐球局</text>
        <text class="muted">今晚有人缺位，适合直接上车</text>
      </view>
      <text class="pill">MATCH</text>
    </view>
    <text wx:if="{{recommendedGames.length === 0}}" class="muted">暂无推荐球局。</text>
    <view
      wx:for="{{recommendedGames}}"
      wx:key="id"
      class="recommend-row"
      bindtap="openTarget"
      data-target="{{item.target}}"
    >
      <view>
        <text class="recommend-title">{{item.title}}</text>
        <text class="recommend-meta">{{item.meta}}</text>
      </view>
      <text class="action-text">查看</text>
    </view>
  </view>

  <view class="section update-card">
    <text class="page-title">今日概览</text>
    <text class="muted">{{summary}}</text>
  </view>
</view>
