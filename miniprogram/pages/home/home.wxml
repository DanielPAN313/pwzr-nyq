<view class="page">
  <view class="topbar">
    <view>
      <text class="location">南京 · Jiangning</text>
    </view>
  </view>

  <view class="hero-swiper-block">
    <view class="hero-dots">
      <view class="hero-dot {{heroIndex === 0 ? 'active' : ''}}"></view>
      <view class="hero-dot {{heroIndex === 1 ? 'active' : ''}}"></view>
    </view>

    <swiper
      class="hero-swiper"
      current="{{heroIndex}}"
      duration="360"
      circular="{{false}}"
      bindchange="onHeroSwiperChange"
    >
      <swiper-item>
        <view class="hero-slide booking-slide">
          <view class="slide-glow"></view>
          <view class="court-lines">
            <view class="court-line court-line-top"></view>
            <view class="court-line court-line-middle"></view>
            <view class="court-line court-line-bottom"></view>
            <view class="court-center"></view>
            <view class="court-ball"></view>
          </view>
          <view class="slide-copy">
            <text class="slide-kicker">卡子门足球场</text>
            <text class="slide-title">本周已订 {{bookingHero.weekBookings}} 场</text>
            <button class="slide-button booking-button" data-action="bookVenue" bindtap="openHeroCard">立即订场</button>
          </view>
        </view>
      </swiper-item>

      <swiper-item>
        <view class="hero-slide recruiting-slide">
          <view class="slide-glow alt"></view>
          <view class="recruit-mark">
            <image class="recruit-mark-logo" src="/assets/kazimen-logo-mark.png" mode="aspectFit" />
          </view>
          <view class="slide-copy">
            <text class="slide-kicker hot">正在组局</text>
            <text class="slide-title">{{gameHero.timeText}} {{gameHero.mode}}</text>
            <text class="slide-meta">{{gameHero.slotsText}} · {{gameHero.feeText}}</text>
            <button
              class="slide-button game-button"
              data-id="{{gameHero.id}}"
              data-title="{{gameHero.title}}"
              data-venue="{{gameHero.venue}}"
              data-desc="{{gameHero.desc}}"
              data-fee="{{gameHero.fee}}"
              bindtap="openHomeGame"
            >
              去这场
            </button>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <text wx:if="{{heroIndex === 0}}" class="hero-swipe-hint">← 滑动查看正在组局的球局 →</text>
  </view>

  <view class="section feature-card">
    <view class="feature-head">
      <view>
        <text class="page-title">正在招人</text>
        <text class="muted">附近还缺人的公开球局，报名即可锁位</text>
      </view>
    </view>
    <view class="sample-stack">
      <view wx:for="{{recruitingGames}}" wx:key="id" class="recruit-card {{item.featured ? 'featured' : ''}}">
        <view class="recruit-thumb">
          <image
            class="recruit-logo"
            src="/assets/kazimen-logo-mark.png"
            mode="aspectFit"
          />
        </view>
        <view class="recruit-body">
          <view class="recruit-top-row">
            <text class="card-title recruit-title">{{item.title}}</text>
            <text class="recruit-countdown">倒计时 {{item.countdownText}} 余 {{item.slotsLeft}} 人</text>
          </view>
          <text class="recruit-line">{{item.reserveLine}}</text>
          <view class="recruit-meta-chips">
            <text class="recruit-chip">{{item.venue}}</text>
            <text class="recruit-chip">{{item.mode}}</text>
            <text class="recruit-chip">{{item.fee}}</text>
          </view>
          <button
            class="book-button recruit-button"
            bindtap="openHomeGame"
            data-id="{{item.id}}"
            data-title="{{item.title}}"
            data-venue="{{item.venue}}"
            data-desc="{{item.desc}}"
            data-fee="{{item.fee}}"
          >
            {{item.actionText}}
          </button>
        </view>
      </view>
    </view>
  </view>
</view>
