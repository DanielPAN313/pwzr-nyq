.home-page {
  background: #07120d;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.location,
.topbar-subtitle {
  display: block;
}

.location {
  color: rgba(247, 251, 245, 0.82);
  font-size: 28rpx;
  font-weight: 900;
}

.topbar-subtitle {
  margin-top: 4rpx;
  color: rgba(247, 251, 245, 0.46);
  font-size: 22rpx;
  font-weight: 700;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: rgba(247, 251, 245, 0.82);
  background: #17231c;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.pill.dark {
  color: #10200f;
  background: #d8ff3e;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 88rpx;
  margin-bottom: 24rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.12);
  border-radius: 28rpx;
  background: #101b15;
  box-sizing: border-box;
}

.search-icon {
  color: #d8ff3e;
  font-size: 34rpx;
  font-weight: 900;
}

.search-text {
  flex: 1;
  color: rgba(247, 251, 245, 0.52);
  font-size: 26rpx;
  font-weight: 700;
}

.search-filter {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 23rpx;
  font-weight: 900;
}

.hero {
  margin-bottom: 22rpx;
}

.court-panel {
  position: relative;
  min-height: 430rpx;
  padding: 30rpx;
  border-radius: 38rpx;
  background: linear-gradient(145deg, #13241a 0%, #0b3d27 48%, #0f8a4f 100%);
  box-shadow: 0 34rpx 72rpx rgba(0, 0, 0, 0.36);
  overflow: hidden;
  box-sizing: border-box;
}

.court-panel::before {
  content: "";
  position: absolute;
  inset: 128rpx 42rpx 34rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.44);
  border-radius: 26rpx;
}

.court-panel::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 128rpx;
  bottom: 34rpx;
  width: 3rpx;
  background: rgba(255, 255, 255, 0.38);
}

.court-glow {
  position: absolute;
  right: -96rpx;
  top: -110rpx;
  width: 310rpx;
  height: 310rpx;
  border-radius: 50%;
  background: rgba(216, 255, 62, 0.22);
}

.court-line,
.court-net {
  position: absolute;
  left: 42rpx;
  right: 42rpx;
  height: 3rpx;
  background: rgba(255, 255, 255, 0.38);
}

.court-line-top {
  top: 230rpx;
}

.court-line-bottom {
  bottom: 118rpx;
}

.court-net {
  top: 286rpx;
  background: #d8ff3e;
  box-shadow: 0 0 26rpx rgba(216, 255, 62, 0.46);
}

.court-ball {
  position: absolute;
  right: 82rpx;
  top: 190rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #d8ff3e;
  box-shadow: 0 0 0 12rpx rgba(216, 255, 62, 0.16);
}

.court-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.title {
  display: block;
  max-width: 520rpx;
  color: #ffffff;
  font-size: 62rpx;
  font-weight: 950;
  line-height: 1.02;
}

.subtitle {
  display: block;
  max-width: 470rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.55;
}

.date-strip {
  display: flex;
  gap: 14rpx;
  margin-bottom: 22rpx;
  overflow: hidden;
}

.date-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  min-height: 66rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: rgba(247, 251, 245, 0.72);
  background: #101b15;
  font-size: 25rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.date-pill.active {
  color: #10200f;
  background: #d8ff3e;
}

.feature-card {
  padding: 22rpx;
}

.match-hub {
  border-color: rgba(216, 255, 62, 0.16);
  background: #0f1913;
}

.match-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.match-tab {
  min-height: 72rpx;
  border-radius: 999rpx;
  color: rgba(247, 251, 245, 0.7);
  background: #17231c;
  font-size: 26rpx;
  font-weight: 950;
}

.match-tab.active {
  color: #10200f;
  background: #d8ff3e;
}

.match-card {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.12);
  border-radius: 28rpx;
  background: #17231c;
  box-sizing: border-box;
}

.match-thumb {
  position: relative;
  flex-shrink: 0;
  width: 168rpx;
  min-height: 224rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #f07a32 0%, #b84d23 48%, #0f8a4f 100%);
  overflow: hidden;
}

.match-thumb-court {
  position: absolute;
  inset: 20rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.48);
  border-radius: 18rpx;
}

.match-thumb-court::before,
.match-thumb-court::after {
  content: "";
  position: absolute;
  background: rgba(255, 255, 255, 0.44);
}

.match-thumb-court::before {
  left: 50%;
  top: 0;
  bottom: 0;
  width: 3rpx;
}

.match-thumb-court::after {
  left: 0;
  right: 0;
  top: 50%;
  height: 3rpx;
}

.match-sport {
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  bottom: 14rpx;
  min-height: 40rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 40rpx;
  text-align: center;
}

.match-main {
  flex: 1;
  min-width: 0;
}

.match-title-row,
.match-footer,
.match-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.match-title {
  display: block;
  color: #f7fbf5;
  font-size: 31rpx;
  font-weight: 950;
  line-height: 1.28;
}

.match-format {
  display: block;
  margin-top: 6rpx;
  color: rgba(247, 251, 245, 0.6);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.4;
}

.match-badge {
  flex-shrink: 0;
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 21rpx;
  font-weight: 950;
  line-height: 42rpx;
}

.countdown-pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  margin-top: 14rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #d8ff3e;
  background: rgba(216, 255, 62, 0.1);
  font-size: 22rpx;
  font-weight: 900;
}

.match-row {
  margin-top: 12rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid rgba(216, 255, 62, 0.08);
}

.match-row-label {
  color: rgba(247, 251, 245, 0.5);
  font-size: 22rpx;
  font-weight: 800;
}

.match-row-value {
  flex: 1;
  min-width: 0;
  color: rgba(247, 251, 245, 0.82);
  font-size: 23rpx;
  font-weight: 900;
  text-align: right;
  line-height: 1.35;
}

.match-footer {
  margin-top: 14rpx;
}

.match-fee {
  color: #f07a32;
  font-size: 28rpx;
  font-weight: 950;
}

.match-action {
  min-height: 50rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 50rpx;
}

.feature-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.venue-card {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
}

.venue-image {
  position: relative;
  flex-shrink: 0;
  width: 178rpx;
  min-height: 178rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #0f8a4f, #1b2b20);
  overflow: hidden;
}

.mini-court {
  position: absolute;
  inset: 24rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 18rpx;
}

.mini-court::before,
.mini-court::after {
  content: "";
  position: absolute;
  background: #d8ff3e;
}

.mini-court::before {
  left: 50%;
  top: 0;
  bottom: 0;
  width: 3rpx;
}

.mini-court::after {
  left: 0;
  right: 0;
  top: 50%;
  height: 3rpx;
}

.venue-info {
  flex: 1;
  min-width: 0;
}

.venue-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
}

.price {
  color: #d8ff3e;
  font-size: 30rpx;
  font-weight: 950;
}

.update-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
