.hero {
  position: relative;
  margin-bottom: 24rpx;
  padding: 34rpx 30rpx 190rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #10231a 0%, #0b3d27 52%, #12824f 100%);
  box-shadow: 0 30rpx 70rpx rgba(16, 32, 22, 0.22);
  overflow: hidden;
}

.hero::before {
  content: "";
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 32rpx;
  height: 118rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.36);
  border-radius: 22rpx;
}

.hero::after {
  content: "";
  position: absolute;
  right: 86rpx;
  bottom: 92rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #d8ff3e;
  box-shadow: 0 0 0 12rpx rgba(216, 255, 62, 0.14), 0 0 36rpx rgba(216, 255, 62, 0.42);
}

.hero .eyebrow {
  position: relative;
  z-index: 1;
  color: rgba(216, 255, 62, 0.92);
}

.title {
  position: relative;
  z-index: 1;
  display: block;
  max-width: 520rpx;
  margin-top: 14rpx;
  color: #ffffff;
  font-size: 58rpx;
  font-weight: 950;
  line-height: 1.08;
}

.subtitle {
  position: relative;
  z-index: 1;
  display: block;
  max-width: 520rpx;
  margin-top: 18rpx;
  color: rgba(247, 251, 245, 0.76);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.55;
}

.stat-grid {
  margin-top: -84rpx;
  position: relative;
  z-index: 2;
}

.stat-card {
  box-shadow: 0 18rpx 42rpx rgba(16, 32, 22, 0.08);
}

.section {
  box-shadow: 0 16rpx 38rpx rgba(16, 32, 22, 0.06);
}

.section-title {
  margin-bottom: 16rpx;
}

.quick-card {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  box-shadow: inset 0 0 0 1rpx rgba(18, 130, 79, 0.14);
}

.todo-card,
.recommend-row {
  transition: transform 120ms ease;
}

.todo-card:active,
.recommend-row:active,
.quick-card:active {
  transform: scale(0.985);
}

.todo-card > view,
.recommend-row > view {
  min-width: 0;
}

.todo-title,
.todo-text,
.recommend-title,
.recommend-meta {
  overflow: hidden;
  text-overflow: ellipsis;
}

.recommend-row {
  min-height: 92rpx;
}

.action-text {
  min-width: 72rpx;
  text-align: right;
}
