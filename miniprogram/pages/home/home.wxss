.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.location {
  display: block;
  color: rgba(247, 251, 245, 0.58);
  font-size: 24rpx;
  font-weight: 800;
}

.hero {
  margin-bottom: 22rpx;
}

.court-panel {
  position: relative;
  min-height: 430rpx;
  padding: 30rpx;
  border-radius: 38rpx;
  background: linear-gradient(145deg, #13241a 0%, #0b3d27 48%, #0f8a4f 100%);
  box-shadow: 0 34rpx 72rpx rgba(0, 0, 0, 0.36);
  overflow: hidden;
  box-sizing: border-box;
}

.court-panel::before {
  content: "";
  position: absolute;
  inset: 128rpx 42rpx 34rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.44);
  border-radius: 26rpx;
}

.court-panel::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 128rpx;
  bottom: 34rpx;
  width: 3rpx;
  background: rgba(255, 255, 255, 0.38);
}

.court-glow {
  position: absolute;
  right: -96rpx;
  top: -110rpx;
  width: 310rpx;
  height: 310rpx;
  border-radius: 50%;
  background: rgba(216, 255, 62, 0.22);
  filter: blur(2rpx);
}

.court-line,
.court-net {
  position: absolute;
  left: 42rpx;
  right: 42rpx;
  height: 3rpx;
  background: rgba(255, 255, 255, 0.38);
}

.court-line-top {
  top: 230rpx;
}

.court-line-bottom {
  bottom: 118rpx;
}

.court-net {
  top: 286rpx;
  background: #d8ff3e;
  box-shadow: 0 0 26rpx rgba(216, 255, 62, 0.46);
}

.court-ball {
  position: absolute;
  right: 82rpx;
  top: 190rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #d8ff3e;
  box-shadow: 0 0 0 12rpx rgba(216, 255, 62, 0.16);
}

.court-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.title {
  display: block;
  max-width: 520rpx;
  color: #FFFFFF;
  font-size: 56rpx;
  font-weight: 950;
  line-height: 1.08;
}

.subtitle {
  display: block;
  max-width: 470rpx;
  color: #999999;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.55;
}

.hero-swiper-block {
  margin-bottom: 22rpx;
}

.hero-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 28rpx;
  margin-bottom: 12rpx;
}

.hero-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #666666;
  opacity: 0.72;
}

.hero-dot.active {
  width: 16rpx;
  height: 16rpx;
  background: #C8FF00;
  opacity: 1;
  box-shadow: 0 0 16rpx rgba(200, 255, 0, 0.42);
}

.hero-swiper {
  height: 300rpx;
  overflow: hidden;
}

.hero-slide {
  position: relative;
  height: 282rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(200, 255, 0, 0.18);
  border-radius: 32rpx;
  background: rgba(12, 31, 21, 0.92);
  box-shadow: 0 24rpx 56rpx rgba(0, 0, 0, 0.28);
  overflow: hidden;
  box-sizing: border-box;
}

.booking-slide {
  background: linear-gradient(145deg, #0d2b1c 0%, #0d4f2f 54%, #0f8a4f 100%);
}

.recruiting-slide {
  background: linear-gradient(145deg, #101b15 0%, #0d3b1e 54%, #1A5C3A 100%);
}

.slide-glow {
  position: absolute;
  right: -80rpx;
  top: -118rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(200, 255, 0, 0.18);
}

.slide-glow.alt {
  right: -52rpx;
  top: -70rpx;
  background: rgba(15, 138, 79, 0.32);
}

.court-lines {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  top: 92rpx;
  bottom: 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 22rpx;
}

.court-lines .court-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.28);
}

.court-lines .court-line-top {
  top: 58rpx;
}

.court-lines .court-line-middle {
  top: 108rpx;
  background: #C8FF00;
}

.court-lines .court-line-bottom {
  bottom: 56rpx;
}

.court-center {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: rgba(255, 255, 255, 0.28);
}

.court-lines .court-ball {
  position: absolute;
  right: 54rpx;
  top: 52rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #C8FF00;
  box-shadow: 0 0 0 14rpx rgba(200, 255, 0, 0.16);
}

.slide-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.slide-kicker {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #C8FF00;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 40rpx;
}

.slide-kicker.hot {
  color: #C8FF00;
  background: rgba(26, 92, 58, 0.88);
}

.slide-title {
  display: block;
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1.12;
}

.slide-meta {
  display: block;
  color: #999999;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
}

.slide-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 156rpx;
  height: 56rpx;
  margin-top: 4rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 950;
  line-height: 56rpx;
}

.booking-button {
  color: #10200f;
  background: #C8FF00;
}

.game-button {
  color: #C8FF00;
  background: #1A5C3A;
}

.recruit-mark {
  position: absolute;
  right: 26rpx;
  bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 124rpx;
  height: 124rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.04);
  box-shadow: inset 0 0 0 1rpx rgba(200, 255, 0, 0.14);
}

.recruit-mark-logo {
  width: 96rpx;
  height: 96rpx;
  filter: drop-shadow(0 0 12rpx rgba(200, 255, 0, 0.22));
}

.hero-swipe-hint {
  display: block;
  margin-top: 8rpx;
  color: #999999;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.4;
  text-align: center;
}

.feature-card {
  padding: 28rpx;
  border-color: rgba(200, 255, 0, 0.12);
  border-radius: 30rpx;
  background: rgba(16, 27, 21, 0.96);
}

.feature-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.feature-copy {
  flex: 1;
  min-width: 300rpx;
}

.feature-filter {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.feature-filter-item {
  min-width: 128rpx;
  height: 46rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #666666;
  background: rgba(255, 255, 255, 0.04);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 46rpx;
}

.feature-filter-item.active {
  color: #10200f;
  background: #C8FF00;
}

.sample-stack {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.recruit-card {
  display: flex;
  align-items: stretch;
  gap: 24rpx;
  min-height: 248rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(200, 255, 0, 0.12);
  border-radius: 28rpx;
  background: linear-gradient(145deg, rgba(8, 24, 17, 0.98) 0%, rgba(6, 18, 13, 0.96) 100%);
  box-sizing: border-box;
  overflow: hidden;
}

.recruit-card.featured {
  border-color: rgba(200, 255, 0, 0.22);
  background: linear-gradient(145deg, rgba(11, 35, 24, 0.98) 0%, rgba(7, 18, 13, 0.98) 100%);
  box-shadow: inset 0 0 0 1rpx rgba(200, 255, 0, 0.08), 0 18rpx 44rpx rgba(0, 0, 0, 0.22);
}

.recruit-thumb {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 216rpx;
  height: 216rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 75% 18%, rgba(200, 255, 0, 0.22), transparent 58rpx),
    linear-gradient(145deg, #3d210f 0%, #83521e 44%, #1A5C3A 100%);
  box-shadow: inset 0 0 0 1rpx rgba(200, 255, 0, 0.18), 0 18rpx 32rpx rgba(0, 0, 0, 0.24);
  overflow: hidden;
}

.recruit-thumb::before {
  content: "";
  position: absolute;
  inset: 34rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 22rpx;
  background:
    linear-gradient(90deg, transparent calc(50% - 1rpx), rgba(200, 255, 0, 0.62) calc(50% - 1rpx), rgba(200, 255, 0, 0.62) calc(50% + 1rpx), transparent calc(50% + 1rpx)),
    linear-gradient(90deg, transparent calc(28% - 1rpx), rgba(255, 255, 255, 0.3) calc(28% - 1rpx), rgba(255, 255, 255, 0.3) calc(28% + 1rpx), transparent calc(28% + 1rpx)),
    linear-gradient(90deg, transparent calc(72% - 1rpx), rgba(255, 255, 255, 0.3) calc(72% - 1rpx), rgba(255, 255, 255, 0.3) calc(72% + 1rpx), transparent calc(72% + 1rpx));
}

.recruit-logo {
  position: relative;
  z-index: 1;
  width: 118rpx;
  height: 118rpx;
  opacity: 0.94;
  filter: drop-shadow(0 0 14rpx rgba(200, 255, 0, 0.18));
}

.recruit-body {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: space-between;
  gap: 12rpx;
}

.recruit-top-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.recruit-title {
  flex: 1;
  min-width: 0;
  max-width: none;
  margin-bottom: 0;
  color: #FFFFFF;
  font-size: 42rpx;
  line-height: 1.08;
}

.recruit-countdown {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  max-width: 260rpx;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #C8FF00;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 44rpx;
  white-space: nowrap;
}

.recruit-line {
  display: block;
  color: #999999;
  font-size: 28rpx;
  font-weight: 750;
  line-height: 1.45;
}

.recruit-meta-chips {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.recruit-chip {
  display: inline-flex;
  align-items: center;
  max-width: 250rpx;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: rgba(247, 251, 245, 0.84);
  background: rgba(255, 255, 255, 0.07);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 42rpx;
  white-space: nowrap;
}

.book-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 116rpx;
  min-height: 62rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: var(--accent-green);
  font-size: 25rpx;
  font-weight: 950;
  line-height: 62rpx;
  text-align: center;
}

.recruit-button {
  align-self: stretch;
  min-width: 0;
  min-height: 74rpx;
  height: 74rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #C8FF00;
  font-size: 28rpx;
  line-height: 74rpx;
  font-weight: 950;
}

@media (max-width: 360px) {
  .feature-card {
    padding: 22rpx;
  }

  .recruit-card {
    gap: 18rpx;
    min-height: 220rpx;
    padding: 18rpx;
  }

  .recruit-thumb {
    width: 184rpx;
    height: 184rpx;
  }

  .recruit-title {
    font-size: 36rpx;
  }

  .recruit-line {
    font-size: 25rpx;
  }

  .recruit-countdown {
    max-width: 220rpx;
    font-size: 21rpx;
  }
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(26rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
