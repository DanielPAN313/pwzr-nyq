.section:first-child {
  position: relative;
  padding: 30rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #10231a 0%, #0b3d27 52%, #12824f 100%);
  box-shadow: 0 28rpx 64rpx rgba(16, 32, 22, 0.2);
  overflow: hidden;
}

.section:first-child::after {
  content: "";
  position: absolute;
  right: -92rpx;
  top: -112rpx;
  width: 290rpx;
  height: 220rpx;
  border-radius: 999rpx;
  background: radial-gradient(ellipse at center, rgba(216, 255, 62, 0.22) 0%, rgba(216, 255, 62, 0.1) 48%, rgba(216, 255, 62, 0) 74%);
}

.page-title {
  position: relative;
  z-index: 1;
  display: block;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.2;
}

.section:first-child .muted {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 12rpx;
  color: rgba(247, 251, 245, 0.76);
  font-size: 25rpx;
  line-height: 1.5;
}

.tabs {
  display: flex;
  width: 100%;
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 150rpx;
  height: 58rpx;
  margin-right: 12rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(219, 228, 216, 0.95);
  border-radius: 999rpx;
  color: #5c6a61;
  font-size: 26rpx;
  font-weight: 800;
  background: #ffffff;
  box-sizing: border-box;
}

.tab.active {
  color: #ffffff;
  border-color: #12824f;
  background: #12824f;
}

.legal-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-shadow: 0 18rpx 44rpx rgba(16, 32, 22, 0.07);
}

.legal-title {
  color: #102016;
  font-size: 36rpx;
  font-weight: 950;
  line-height: 1.25;
}

.legal-meta {
  color: #12824f;
  font-size: 24rpx;
  font-weight: 850;
}

.legal-intro {
  color: #334138;
  font-size: 27rpx;
  line-height: 1.55;
  font-weight: 750;
}

.legal-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(219, 228, 216, 0.9);
}

.legal-index {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  background: #12824f;
}

.legal-text {
  flex: 1;
  color: #5c6a61;
  font-size: 26rpx;
  line-height: 1.5;
  font-weight: 750;
}

.legal-card {
  border-color: rgba(216, 255, 62, 0.12);
  background: #17231c;
}

.legal-title,
.legal-intro {
  color: #f7fbf5;
}

.legal-meta,
.legal-index {
  color: #10200f;
  background: #d8ff3e;
}

.legal-row {
  border-top-color: rgba(216, 255, 62, 0.1);
}

.legal-text {
  color: rgba(247, 251, 245, 0.72);
}

.tab {
  border-color: rgba(216, 255, 62, 0.12);
  color: rgba(247, 251, 245, 0.72);
  background: #17231c;
}

.tab.active {
  color: #10200f;
  border-color: #d8ff3e;
  background: #d8ff3e;
}
