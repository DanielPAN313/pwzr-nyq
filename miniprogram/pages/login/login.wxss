.login-page {
  min-height: 100vh;
  padding: 108rpx 32rpx 64rpx;
  color: #f7fbf5;
  background: #07120d;
  box-sizing: border-box;
}

.login-hero {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 44rpx;
}

.login-kicker {
  color: #d8ff3e;
  font-size: 22rpx;
  font-weight: 900;
}

.login-title {
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 950;
  line-height: 1.15;
}

.login-copy {
  color: rgba(247, 251, 245, 0.62);
  font-size: 27rpx;
  line-height: 1.55;
}

.role-switch {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.role-option {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(247, 251, 245, 0.1);
  border-radius: 16rpx;
  background: #101b15;
  box-sizing: border-box;
}

.role-option-active {
  border-color: #d8ff3e;
  background: #17251b;
}

.role-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  color: #10200f;
  background: #d8ff3e;
  font-size: 25rpx;
  font-weight: 950;
}

.role-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.role-title {
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 900;
}

.role-hint {
  color: rgba(247, 251, 245, 0.54);
  font-size: 23rpx;
}

.role-check {
  width: 36rpx;
  color: #d8ff3e;
  font-size: 30rpx;
  font-weight: 950;
  text-align: center;
}

.venue-form {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #101b15;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: rgba(247, 251, 245, 0.7);
  font-size: 23rpx;
  font-weight: 800;
}

.field-input {
  width: 100%;
  min-height: 74rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(247, 251, 245, 0.12);
  border-radius: 12rpx;
  color: #ffffff;
  background: #07120d;
  font-size: 28rpx;
  box-sizing: border-box;
}

.field-placeholder {
  color: rgba(247, 251, 245, 0.34);
}

.test-account {
  color: rgba(216, 255, 62, 0.72);
  font-size: 21rpx;
}

.form-error {
  display: block;
  margin-top: 18rpx;
  color: #ff9b9b;
  font-size: 24rpx;
}

.login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 28rpx;
  border-radius: 44rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 29rpx;
  font-weight: 950;
  line-height: 88rpx;
}

.login-button[disabled] {
  color: rgba(16, 32, 15, 0.7);
  background: rgba(216, 255, 62, 0.55);
}

.privacy-note {
  display: block;
  margin-top: 20rpx;
  color: rgba(247, 251, 245, 0.38);
  font-size: 21rpx;
  text-align: center;
}
