<view class="page">
  <view class="profile">
    <view class="profile-top">
      <text class="avatar">NYQ</text>
      <text class="profile-tag">{{profileTag}}</text>
    </view>
    <text class="name">{{profileName}}</text>
    <text wx:if="{{loading}}" class="profile-hint">正在加载个人信息...</text>
    <text wx:else class="profile-hint">{{profileHint}}</text>
    <view class="profile-stats">
      <view wx:for="{{profileStats}}" wx:key="label" class="stat-card stat-{{item.tone}}">
        <text class="stat-value">{{item.value}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="section menu-section">
    <view class="section-head">
      <text class="section-title">功能入口</text>
      <text class="section-hint">查看订单、球局、信用和规则</text>
    </view>
    <view wx:for="{{items}}" wx:key="label" class="menu-row" bindtap="openMenu" data-target="{{item.target}}">
      <view class="menu-copy">
        <text class="menu-label">{{item.label}}</text>
        <text class="menu-hint">{{item.hint}}</text>
      </view>
      <view class="menu-meta">
        <text class="menu-value menu-{{item.tone}}">{{item.value}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
</view>
