.profile {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 24rpx;
  padding: 34rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.14);
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #0d2118 0%, #0f5a36 54%, #12824f 100%);
  box-shadow: 0 24rpx 56rpx rgba(0, 0, 0, 0.24);
  overflow: hidden;
}

.profile::after {
  content: "";
  position: absolute;
  right: -74rpx;
  bottom: -96rpx;
  width: 270rpx;
  height: 270rpx;
  border: 2rpx solid rgba(216, 255, 62, 0.18);
  border-radius: 50%;
}

.profile-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  color: #083923;
  background: #d8ff3e;
  font-size: 28rpx;
  font-weight: 950;
  letter-spacing: 0;
}

.profile-tag {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 24rpx;
  font-weight: 950;
}

.name {
  position: relative;
  z-index: 1;
  color: #f7fbf5;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.18;
}

.profile-hint {
  position: relative;
  z-index: 1;
  max-width: 560rpx;
  color: rgba(247, 251, 245, 0.78);
  font-size: 26rpx;
  line-height: 1.55;
}

.profile-stats {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 6rpx;
}

.stat-card {
  min-height: 106rpx;
  padding: 18rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.12);
  box-sizing: border-box;
}

.stat-value,
.stat-label {
  display: block;
}

.stat-value {
  color: #d8ff3e;
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1.1;
}

.stat-label {
  margin-top: 8rpx;
  color: rgba(247, 251, 245, 0.72);
  font-size: 22rpx;
  font-weight: 850;
}

.menu-section {
  padding: 0;
  overflow: hidden;
}

.section-head {
  padding: 26rpx 26rpx 12rpx;
}

.section-title {
  display: block;
  color: #f7fbf5;
  font-size: 31rpx;
  font-weight: 950;
  line-height: 1.35;
}

.section-hint {
  display: block;
  margin-top: 6rpx;
  color: rgba(247, 251, 245, 0.58);
  font-size: 24rpx;
  line-height: 1.45;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 118rpx;
  margin: 0 18rpx;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid rgba(216, 255, 62, 0.12);
  box-sizing: border-box;
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-copy {
  min-width: 0;
}

.menu-label {
  display: block;
  color: #f7fbf5;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.28;
}

.menu-hint {
  display: block;
  margin-top: 8rpx;
  color: rgba(247, 251, 245, 0.56);
  font-size: 24rpx;
  line-height: 1.4;
}

.menu-meta {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 8rpx;
}

.menu-value {
  max-width: 180rpx;
  color: rgba(247, 251, 245, 0.74);
  font-size: 27rpx;
  font-weight: 950;
  line-height: 1.2;
  text-align: right;
}

.menu-accent {
  color: #d8ff3e;
}

.menu-warning {
  color: #ffd166;
}

.menu-subtle {
  color: rgba(247, 251, 245, 0.62);
}

.menu-arrow {
  color: rgba(216, 255, 62, 0.82);
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1;
}
