.profile {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #10231a 0%, #0b3d27 54%, #12824f 100%);
  box-shadow: 0 28rpx 64rpx rgba(16, 32, 22, 0.2);
  overflow: hidden;
}

.profile::after {
  content: "";
  position: absolute;
  right: -86rpx;
  bottom: -98rpx;
  width: 270rpx;
  height: 220rpx;
  border-radius: 999rpx;
  background: radial-gradient(ellipse at center, rgba(216, 255, 62, 0.22) 0%, rgba(216, 255, 62, 0.1) 48%, rgba(216, 255, 62, 0) 74%);
}

.avatar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
  color: #10200f;
  background: #d8ff3e;
  box-shadow: 0 18rpx 42rpx rgba(216, 255, 62, 0.18);
  font-size: 28rpx;
  font-weight: 950;
}

.name {
  position: relative;
  z-index: 1;
  display: block;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 950;
  line-height: 1.22;
}

.profile .muted {
  position: relative;
  z-index: 1;
  color: rgba(247, 251, 245, 0.76);
  font-size: 25rpx;
  line-height: 1.55;
}

.stat-grid {
  margin-bottom: 24rpx;
}

.stat-card {
  box-shadow: 0 18rpx 42rpx rgba(16, 32, 22, 0.08);
}

.menu-section {
  padding: 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 18rpx 44rpx rgba(16, 32, 22, 0.06);
}

.menu-section .section-title {
  margin-bottom: 10rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  gap: 18rpx;
  border-bottom: 1rpx solid rgba(219, 228, 216, 0.9);
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-main {
  flex: 1;
  min-width: 0;
  align-items: flex-start;
}

.menu-label {
  display: block;
  color: #102016;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.menu-hint {
  margin-top: 6rpx;
}

.menu-value {
  flex-shrink: 0;
  color: #12824f;
  font-size: 27rpx;
  font-weight: 900;
  text-align: right;
}
