.hero-action {
  position: relative;
  z-index: 1;
  align-self: flex-start;
  margin-top: 12rpx;
}

.message-section {
  padding: 24rpx;
  border-radius: 28rpx;
}

.section-head {
  margin-bottom: 18rpx;
}

.section-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #d8ff3e;
  line-height: 44rpx;
  text-align: center;
}

.message-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.1);
  border-radius: 22rpx;
  background: #17231c;
}

.message-card + .message-card {
  margin-top: 16rpx;
}

.message-active {
  border-color: rgba(216, 255, 62, 0.24);
}

.message-muted {
  opacity: 0.76;
}

.message-head {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.message-dot {
  flex-shrink: 0;
  width: 18rpx;
  height: 18rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #d8ff3e;
  box-shadow: 0 0 0 8rpx rgba(216, 255, 62, 0.18);
}

.message-copy {
  flex: 1;
  min-width: 0;
}

.status-pill {
  flex-shrink: 0;
  min-height: 44rpx;
  padding: 0 16rpx;
}

.status-active {
  color: #10200f;
  background: #d8ff3e;
}

.status-muted {
  color: rgba(247, 251, 245, 0.66);
  background: #334139;
}

.message-footer {
  align-items: flex-end;
  margin-top: 2rpx;
}

.target-hint {
  min-width: 0;
}
