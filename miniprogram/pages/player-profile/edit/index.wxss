.profile-edit-page {
  padding-bottom: 310rpx;
}

.edit-status,
.rating-overview,
.section-head,
.dimension-head,
.fallback-copy {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.edit-status {
  gap: 20rpx;
  margin-bottom: 22rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.18);
  border-radius: 18rpx;
  background: #101b15;
}

.edit-status.locked {
  border-color: rgba(255, 188, 76, 0.2);
}

.status-label,
.status-title {
  display: block;
}

.status-label,
.section-note,
.overview-note,
.score-label {
  color: rgba(247, 251, 245, 0.58);
  font-size: 22rpx;
  line-height: 1.45;
}

.status-title {
  margin-top: 5rpx;
  color: #f7fbf5;
  font-size: 25rpx;
  font-weight: 850;
}

.status-chip,
.average-pill {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 21rpx;
  font-weight: 900;
}

.locked .status-chip {
  color: #2c230e;
  background: #ffbc4c;
}

.rating-overview {
  align-items: flex-end;
  gap: 24rpx;
  margin-bottom: 24rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.16);
  border-radius: 24rpx;
  background: linear-gradient(145deg, #10231a 0%, #0b3d27 58%, #12824f 100%);
}

.overview-title {
  display: block;
  margin: 16rpx 0 8rpx;
  color: #ffffff;
  font-size: 39rpx;
  font-weight: 950;
}

.score-block {
  flex-shrink: 0;
  text-align: right;
}

.score-value,
.score-label {
  display: block;
}

.score-value {
  color: #d8ff3e;
  font-size: 58rpx;
  font-weight: 950;
  line-height: 1;
}

.section-head {
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.section-title,
.section-note {
  display: block;
}

.section-title {
  margin-bottom: 5rpx;
  color: #f7fbf5;
  font-size: 30rpx;
  font-weight: 950;
}

.radar-section {
  min-height: 340rpx;
}

.radar-canvas {
  width: 320px;
  max-width: 100%;
  height: 270px;
  margin: 0 auto;
}

.dimension-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(247, 251, 245, 0.08);
}

.dimension-row:last-child {
  border-bottom: 0;
}

.dimension-name {
  color: #f7fbf5;
  font-size: 26rpx;
  font-weight: 850;
}

.dimension-value {
  color: #d8ff3e;
  font-size: 30rpx;
  font-weight: 950;
}

.position-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.position-option {
  min-width: 0;
  min-height: 66rpx;
  border: 1rpx solid rgba(247, 251, 245, 0.1);
  border-radius: 12rpx;
  color: rgba(247, 251, 245, 0.7);
  background: #07120d;
  font-size: 23rpx;
  font-weight: 850;
  line-height: 66rpx;
}

.position-option.selected {
  border-color: #d8ff3e;
  color: #10200f;
  background: #d8ff3e;
}

.fallback-bars {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.fallback-copy {
  margin-bottom: 8rpx;
  color: #f7fbf5;
  font-size: 23rpx;
}

.fallback-track {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(247, 251, 245, 0.1);
  overflow: hidden;
}

.fallback-fill {
  height: 100%;
  border-radius: inherit;
  background: #d8ff3e;
}

.save-button {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 950;
  min-height: 92rpx;
  border-radius: 18rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 29rpx;
  font-weight: 950;
  line-height: 92rpx;
}

.save-button[disabled] {
  color: rgba(247, 251, 245, 0.58);
  background: #334138;
}

@media (max-width: 360px) {
  .rating-overview {
    align-items: flex-start;
    flex-direction: column;
  }

  .score-block {
    text-align: left;
  }

  .position-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
