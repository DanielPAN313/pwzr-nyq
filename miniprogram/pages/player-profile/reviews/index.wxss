.reviews-page {
  padding-bottom: 290rpx;
}

.review-hero,
.review-top,
.review-foot,
.review-heading,
.fallback-copy {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review-hero {
  align-items: flex-end;
  gap: 22rpx;
  margin-bottom: 18rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.16);
  border-radius: 24rpx;
  background: linear-gradient(145deg, #10231a 0%, #0b3d27 58%, #12824f 100%);
}

.hero-title {
  display: block;
  margin: 16rpx 0 8rpx;
  color: #ffffff;
  font-size: 39rpx;
  font-weight: 950;
}

.hero-note,
.summary-label,
.review-venue,
.review-foot,
.review-heading-note {
  color: rgba(247, 251, 245, 0.58);
  font-size: 22rpx;
  line-height: 1.45;
}

.hero-score {
  flex-shrink: 0;
  text-align: right;
}

.hero-score-value,
.hero-score-label {
  display: block;
}

.hero-score-value {
  color: #d8ff3e;
  font-size: 56rpx;
  font-weight: 950;
  line-height: 1;
}

.hero-score-label {
  margin-top: 7rpx;
  color: rgba(247, 251, 245, 0.64);
  font-size: 21rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.summary-item {
  min-height: 112rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.1);
  border-radius: 16rpx;
  background: #101b15;
  box-sizing: border-box;
}

.summary-value,
.summary-label {
  display: block;
}

.summary-value {
  color: #d8ff3e;
  font-size: 34rpx;
  font-weight: 950;
}

.radar-section {
  min-height: 340rpx;
}

.radar-canvas {
  width: 320px;
  max-width: 100%;
  height: 270px;
  margin: 0 auto;
}

.section-title {
  color: #f7fbf5;
  font-size: 30rpx;
  font-weight: 950;
}

.review-heading {
  align-items: flex-end;
  margin: 4rpx 4rpx 18rpx;
}

.review-card {
  border-color: rgba(216, 255, 62, 0.1);
}

.review-card.negative {
  border-color: rgba(255, 113, 113, 0.3);
}

.review-top {
  align-items: flex-start;
  gap: 16rpx;
}

.review-name,
.review-venue {
  display: block;
}

.review-name {
  color: #f7fbf5;
  font-size: 27rpx;
  font-weight: 900;
}

.review-venue {
  margin-top: 5rpx;
}

.star-row {
  display: flex;
  flex-shrink: 0;
  gap: 2rpx;
}

.star {
  color: #334138;
  font-size: 23rpx;
}

.star.filled {
  color: #d8ff3e;
}

.review-content {
  display: block;
  margin: 20rpx 0;
  color: rgba(247, 251, 245, 0.78);
  font-size: 25rpx;
  line-height: 1.6;
}

.negative-tag {
  padding: 5rpx 10rpx;
  border-radius: 7rpx;
  color: #ff9b9b;
  background: rgba(255, 113, 113, 0.12);
  font-weight: 850;
}

.fallback-bars {
  display: flex;
  flex-direction: column;
  gap: 17rpx;
  margin-top: 22rpx;
}

.fallback-copy {
  margin-bottom: 8rpx;
  color: #f7fbf5;
  font-size: 23rpx;
}

.fallback-track {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(247, 251, 245, 0.1);
  overflow: hidden;
}

.fallback-fill {
  height: 100%;
  border-radius: inherit;
  background: #d8ff3e;
}

@media (max-width: 360px) {
  .review-hero {
    align-items: flex-start;
    flex-direction: column;
  }

  .hero-score {
    text-align: left;
  }

  .summary-grid {
    grid-template-columns: 1fr;
  }
}
