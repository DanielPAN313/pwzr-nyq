<view class="register-page">
  <view class="register-ambient ambient-one"></view>
  <view class="register-ambient ambient-two"></view>

  <view class="register-hero">
    <text class="register-kicker">NINGYUEQIU ACCOUNT</text>
    <text class="register-title">创建你的球局账户</text>
    <text class="register-copy">用邮箱、账户名和密码保存报名、邀请和订单信息。</text>
  </view>

  <view class="register-form">
    <view class="field">
      <text class="field-label">邮箱</text>
      <input
        class="field-input"
        type="text"
        placeholder="you@example.com"
        placeholder-class="field-placeholder"
        value="{{email}}"
        data-field="email"
        bindinput="updateField"
      />
    </view>

    <view class="field">
      <text class="field-label">账户名</text>
      <input
        class="field-input"
        type="text"
        placeholder="输入你的账户名"
        placeholder-class="field-placeholder"
        value="{{username}}"
        data-field="username"
        bindinput="updateField"
      />
    </view>

    <view class="field">
      <text class="field-label">密码</text>
      <input
        class="field-input"
        password
        placeholder="至少 6 位"
        placeholder-class="field-placeholder"
        value="{{password}}"
        data-field="password"
        bindinput="updateField"
      />
    </view>

    <text wx:if="{{error}}" class="form-error">{{error}}</text>

    <button class="register-button" bindtap="submitRegister">创建账号</button>
    <button class="login-entry-button" bindtap="goLogin">登录账号</button>
  </view>
</view>
