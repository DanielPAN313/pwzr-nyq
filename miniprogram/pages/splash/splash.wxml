<view class="page splash-page">
  <view class="light-spot light-spot-top"></view>
  <view class="light-spot light-spot-bottom"></view>

  <view class="section splash-stage">
    <view class="court-card">
      <view class="court-line line-top"></view>
      <view class="court-line line-mid"></view>
      <view class="court-line line-bottom"></view>
      <view class="court-axis axis-left"></view>
      <view class="court-axis axis-right"></view>
      <view class="motion-ball"></view>
    </view>

    <view class="brand-mark">
      <text>宁</text>
    </view>
  </view>

  <view class="section brand-copy">
    <text class="brand-name">宁约球</text>
    <text class="brand-line">Play begins here.</text>
    <view class="splash-actions">
      <button class="primary small enter-button" bindtap="enterHome">立即进入</button>
      <button class="secondary small account-button" bindtap="openAuth">创建账号 / 登录</button>
    </view>
  </view>

  <view class="progress">
    <view class="progress-fill"></view>
  </view>
</view>
