.create-hero {
  margin-bottom: 24rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.16);
  border-radius: 28rpx;
  background: linear-gradient(145deg, #10231a 0%, #0b3d27 58%, #12824f 100%);
}

.create-hero .page-title {
  margin-top: 18rpx;
  margin-bottom: 8rpx;
  font-size: 40rpx;
}

.hero-note {
  color: rgba(247, 251, 245, 0.68);
  font-size: 24rpx;
  line-height: 1.5;
}

.team-preview {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 28rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(7, 18, 13, 0.5);
}

.preview-badge {
  display: flex;
  flex: 0 0 84rpx;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 18rpx;
  color: #10200f;
  font-size: 36rpx;
  font-weight: 950;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.preview-copy {
  min-width: 0;
  flex: 1;
}

.preview-name,
.preview-meta {
  display: block;
}

.preview-name {
  overflow: hidden;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 950;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-meta {
  margin-top: 8rpx;
  color: rgba(247, 251, 245, 0.56);
  font-size: 21rpx;
}

.form-panel,
.field {
  display: flex;
  flex-direction: column;
}

.form-panel {
  gap: 26rpx;
}

.field {
  position: relative;
  gap: 10rpx;
}

.field-label,
.switch-title,
.switch-note {
  display: block;
}

.field-label,
.switch-title {
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
}

.field-input,
.picker-value,
.field-textarea {
  width: 100%;
  min-height: 84rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.12);
  border-radius: 16rpx;
  background: #07120d;
  color: #ffffff;
  font-size: 27rpx;
  line-height: 42rpx;
  box-sizing: border-box;
}

.field-textarea {
  min-height: 178rpx;
  padding-bottom: 46rpx;
  line-height: 1.55;
}

.field-count {
  position: absolute;
  right: 18rpx;
  bottom: 14rpx;
  color: rgba(247, 251, 245, 0.42);
  font-size: 20rpx;
}

.badge-editor,
.color-swatches,
.switch-row {
  display: flex;
  align-items: center;
}

.badge-editor,
.switch-row {
  justify-content: space-between;
  gap: 18rpx;
}

.badge-upload {
  min-width: 150rpx;
  min-height: 68rpx;
  border-radius: 14rpx;
  color: #d8ff3e;
  background: #1a5c3a;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 68rpx;
}

.color-swatches {
  gap: 10rpx;
}

.color-swatch {
  width: 48rpx;
  height: 48rpx;
  border: 5rpx solid #101b15;
  border-radius: 50%;
  box-shadow: 0 0 0 1rpx rgba(247, 251, 245, 0.18);
}

.color-swatch.selected {
  box-shadow: 0 0 0 4rpx #ffffff;
}

.switch-row {
  min-height: 88rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(247, 251, 245, 0.08);
}

.switch-note {
  margin-top: 7rpx;
  color: rgba(247, 251, 245, 0.48);
  font-size: 21rpx;
}

.submit-button {
  position: sticky;
  bottom: 24rpx;
  z-index: 5;
  min-height: 88rpx;
  border-radius: 16rpx;
  font-size: 29rpx;
  font-weight: 950;
  line-height: 88rpx;
  box-shadow: 0 18rpx 44rpx rgba(18, 130, 79, 0.28);
}

.submit-button[disabled] {
  box-shadow: none;
}

@media (max-width: 360px) {
  .badge-editor {
    align-items: flex-start;
    flex-direction: column;
  }
}
