.team-hero {
  margin-bottom: 30rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.16);
  border-radius: 28rpx;
  background: linear-gradient(145deg, #10231a 0%, #0b3d27 56%, #12824f 100%);
}

.team-hero .page-title {
  margin-top: 18rpx;
  margin-bottom: 8rpx;
  font-size: 42rpx;
}

.hero-note {
  color: rgba(247, 251, 245, 0.72);
  font-size: 25rpx;
  line-height: 1.5;
}

.hub-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 28rpx;
}

.hub-entry {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  min-height: 174rpx;
  padding: 18rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 16rpx;
  background: rgba(7, 18, 13, 0.52);
  text-align: left;
}

.hub-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border-radius: 12rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 46rpx;
}

.hub-title {
  margin-top: 14rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.3;
}

.hub-note {
  margin-top: 6rpx;
  color: rgba(247, 251, 245, 0.56);
  font-size: 20rpx;
  line-height: 1.35;
}

.list-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 6rpx 4rpx 20rpx;
}

.list-title,
.list-note {
  display: block;
}

.list-title {
  color: #f7fbf5;
  font-size: 31rpx;
  font-weight: 950;
}

.list-note,
.list-count {
  margin-top: 6rpx;
  color: rgba(247, 251, 245, 0.56);
  font-size: 22rpx;
}

.team-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  border-color: rgba(216, 255, 62, 0.12);
}

.team-head,
.team-foot,
.captain-line {
  display: flex;
  align-items: center;
}

.team-head {
  gap: 18rpx;
}

.team-badge {
  display: flex;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  color: #10200f;
  font-size: 38rpx;
  font-weight: 950;
  overflow: hidden;
}

.team-badge-image {
  width: 100%;
  height: 100%;
}

.team-identity {
  min-width: 0;
  flex: 1;
}

.team-identity .card-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-venue {
  color: rgba(247, 251, 245, 0.58);
  font-size: 23rpx;
  line-height: 1.4;
}

.team-arrow {
  color: #d8ff3e;
  font-size: 48rpx;
  line-height: 1;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.team-tag {
  padding: 7rpx 13rpx;
  border-radius: 8rpx;
  color: #d8ff3e;
  background: rgba(216, 255, 62, 0.1);
  font-size: 21rpx;
  font-weight: 850;
}

.team-desc {
  color: rgba(247, 251, 245, 0.66);
  font-size: 25rpx;
  line-height: 1.55;
}

.team-metrics {
  display: grid;
  grid-template-columns: 0.8fr 1fr 1.65fr;
  gap: 10rpx;
}

.metric {
  min-width: 0;
  padding: 16rpx;
  border-radius: 14rpx;
  background: #07120d;
}

.metric-value,
.metric-label {
  display: block;
}

.metric-value {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 950;
  line-height: 1.25;
}

.metric-value.small {
  overflow: hidden;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-label {
  margin-top: 8rpx;
  color: rgba(247, 251, 245, 0.48);
  font-size: 20rpx;
}

.team-foot {
  justify-content: space-between;
  gap: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(247, 251, 245, 0.08);
}

.captain-line {
  min-width: 0;
  gap: 10rpx;
}

.captain-label {
  color: rgba(247, 251, 245, 0.48);
  font-size: 22rpx;
}

.captain-name {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 850;
}

.join-button {
  flex: 0 0 154rpx;
  min-height: 64rpx;
  border-radius: 14rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 64rpx;
}

.join-button[disabled] {
  color: rgba(247, 251, 245, 0.64);
  background: #334138;
}

@media (max-width: 360px) {
  .hub-grid {
    grid-template-columns: 1fr;
  }

  .hub-entry {
    min-height: 120rpx;
  }

  .team-metrics {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .metric.wide {
    grid-column: 1 / -1;
  }
}
