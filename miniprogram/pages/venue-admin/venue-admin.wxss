.section:first-child {
  position: relative;
  padding: 30rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #10231a 0%, #0b3d27 52%, #12824f 100%);
  box-shadow: 0 28rpx 64rpx rgba(16, 32, 22, 0.2);
  overflow: hidden;
}

.section:first-child::after {
  content: "";
  position: absolute;
  right: -92rpx;
  top: -112rpx;
  width: 290rpx;
  height: 220rpx;
  border-radius: 999rpx;
  background: radial-gradient(ellipse at center, rgba(216, 255, 62, 0.22) 0%, rgba(216, 255, 62, 0.1) 48%, rgba(216, 255, 62, 0) 74%);
}

.page-title {
  position: relative;
  z-index: 1;
  display: block;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.2;
}

.section:first-child .muted {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 12rpx;
  color: rgba(247, 251, 245, 0.76);
  font-size: 25rpx;
  line-height: 1.5;
}

.section-title,
.card-title {
  display: block;
  margin-bottom: 10rpx;
  color: #102016;
  font-size: 31rpx;
  font-weight: 950;
  line-height: 1.35;
}

.card-title {
  margin-bottom: 8rpx;
  font-size: 29rpx;
}

.step-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.step-card {
  min-height: 152rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(219, 228, 216, 0.95);
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(16, 32, 22, 0.06);
  box-sizing: border-box;
}

.step-title {
  display: block;
  color: #102016;
  font-size: 25rpx;
  font-weight: 950;
  line-height: 1.35;
}

.step-text {
  display: block;
  margin-top: 8rpx;
  color: #6f7c72;
  font-size: 22rpx;
  line-height: 1.45;
  font-weight: 750;
}

.section-hint {
  color: #6f7c72;
  font-size: 24rpx;
  line-height: 1.5;
}

.checkin-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.application-panel,
.maintenance-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  border-color: rgba(18, 130, 79, 0.14);
}

.form-input,
.code-input {
  width: 100%;
  min-height: 84rpx;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(18, 130, 79, 0.18);
  border-radius: 18rpx;
  background: #eef6ed;
  color: #102016;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 44rpx;
}

.form-textarea {
  width: 100%;
  min-height: 168rpx;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(18, 130, 79, 0.18);
  border-radius: 18rpx;
  background: #eef6ed;
  color: #102016;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.55;
}

.validation-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10rpx;
}

.validation-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 58rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  background: #fbfdf9;
  box-sizing: border-box;
}

.validation-item.is-ok {
  background: #ecfdf3;
}

.validation-item.is-pending {
  background: #fff7ed;
}

.validation-dot {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #f97316;
  font-size: 22rpx;
  font-weight: 900;
}

.validation-item.is-ok .validation-dot {
  background: #12824f;
}

.validation-text {
  color: #334138;
  font-size: 24rpx;
  line-height: 1.4;
  font-weight: 750;
}

.code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.code-button {
  flex-shrink: 0;
  min-width: 140rpx;
  min-height: 84rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 900;
}

.result-text {
  color: #12824f;
  font-size: 26rpx;
  font-weight: 900;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.metric-card {
  min-height: 132rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(219, 228, 216, 0.9);
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(16, 32, 22, 0.06);
  box-sizing: border-box;
}

.metric-value {
  display: block;
  margin-bottom: 8rpx;
  color: #102016;
  font-size: 40rpx;
  font-weight: 950;
  line-height: 1.15;
}

.venue-row,
.order-row,
.checkin-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.venue-row {
  min-height: 92rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(219, 228, 216, 0.9);
  box-sizing: border-box;
}

.order-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  box-shadow: 0 18rpx 44rpx rgba(16, 32, 22, 0.08);
  overflow: hidden;
}

.order-card.is-highlighted {
  border-color: #12824f;
  box-shadow: 0 0 0 4rpx rgba(18, 130, 79, 0.1), 0 18rpx 44rpx rgba(16, 32, 22, 0.08);
}

.price {
  color: #12824f;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1.15;
}

.status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #12824f;
  background: #eef6ed;
  font-size: 24rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.checkin-box {
  padding: 20rpx;
  border-radius: 18rpx;
  background: #eef6ed;
}

.checkin-code {
  color: #102016;
  font-size: 36rpx;
  font-weight: 950;
  letter-spacing: 2rpx;
}

.order-step {
  display: block;
  padding: 18rpx 20rpx;
  border-left: 6rpx solid #94a3b8;
  border-radius: 18rpx;
  background: #f8fafc;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 850;
}

.application-panel button,
.maintenance-panel button,
.order-card button {
  min-height: 82rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.order-warning {
  border-left-color: #f97316;
  background: #fff7ed;
  color: #c2410c;
}

.order-info {
  border-left-color: #3b82f6;
  background: #eff6ff;
  color: #1d4ed8;
}

.order-success {
  border-left-color: #12b76a;
  background: #ecfdf3;
  color: #067647;
}

.order-muted {
  border-left-color: #94a3b8;
  background: #f1f5f9;
  color: #64748b;
}
