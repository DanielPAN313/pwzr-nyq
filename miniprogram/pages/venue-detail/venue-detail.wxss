.section:first-child {
  position: relative;
  padding: 30rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #10231a 0%, #0b3d27 52%, #12824f 100%);
  box-shadow: 0 28rpx 64rpx rgba(16, 32, 22, 0.2);
  overflow: hidden;
}

.section:first-child::after {
  content: "";
  position: absolute;
  right: -92rpx;
  top: -112rpx;
  width: 290rpx;
  height: 220rpx;
  border-radius: 999rpx;
  background: radial-gradient(ellipse at center, rgba(216, 255, 62, 0.22) 0%, rgba(216, 255, 62, 0.1) 48%, rgba(216, 255, 62, 0) 74%);
}

.page-title {
  position: relative;
  z-index: 1;
  display: block;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.2;
}

.section:first-child .muted {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 12rpx;
  color: rgba(247, 251, 245, 0.76);
  font-size: 25rpx;
  line-height: 1.5;
}

.section-title {
  display: block;
  margin-bottom: 18rpx;
  color: #102016;
  font-size: 31rpx;
  font-weight: 950;
  line-height: 1.35;
}

.venue-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 36rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #10231a 0%, #0b3d27 48%, #12824f 100%);
  box-shadow: 0 28rpx 64rpx rgba(16, 32, 22, 0.18);
  overflow: hidden;
}

.venue-hero::after {
  content: "";
  position: absolute;
  right: -92rpx;
  bottom: -110rpx;
  width: 310rpx;
  height: 230rpx;
  border-radius: 999rpx;
  background: radial-gradient(ellipse at center, rgba(216, 255, 62, 0.2) 0%, rgba(216, 255, 62, 0.08) 48%, rgba(216, 255, 62, 0) 74%);
  pointer-events: none;
}

.venue-title {
  position: relative;
  z-index: 1;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.18;
}

.venue-tag {
  position: relative;
  z-index: 1;
  align-self: flex-start;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #083923;
  background: #d7f36a;
  font-size: 24rpx;
  font-weight: 850;
}

.venue-muted {
  position: relative;
  z-index: 1;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  line-height: 1.45;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.detail-card {
  min-height: 116rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(219, 228, 216, 0.95);
  border-radius: 18rpx;
  background: #fbfdf9;
  box-sizing: border-box;
}

.detail-value {
  display: block;
  color: #102016;
  font-size: 27rpx;
  font-weight: 950;
  line-height: 1.28;
  word-break: break-all;
}

.detail-label {
  display: block;
  margin-top: 8rpx;
  color: #6f7c72;
  font-size: 22rpx;
  font-weight: 800;
}

.picker-value {
  min-height: 84rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(18, 130, 79, 0.18);
  border-radius: 18rpx;
  background: #eef6ed;
  color: #102016;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 44rpx;
  box-sizing: border-box;
}

.slot-summary {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(219, 228, 216, 0.9);
  border-radius: 18rpx;
  background: #fbfdf9;
}

.slot-summary-title {
  color: #102016;
  font-size: 26rpx;
  font-weight: 850;
}

.slot-summary-text {
  color: #6f7c72;
  font-size: 24rpx;
  line-height: 1.5;
}

.slot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 92rpx;
  margin-bottom: 14rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
  background: #fbfdf9;
  color: #102016;
  font-size: 28rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 28rpx rgba(16, 32, 22, 0.05);
  box-sizing: border-box;
}

.slot-row.selected {
  border-color: #12824f;
  background: #e4f6e9;
  box-shadow: 0 14rpx 34rpx rgba(18, 130, 79, 0.12);
}

.slot-row.disabled {
  opacity: 0.48;
  box-shadow: none;
}

.slot-status {
  flex-shrink: 0;
  min-width: 106rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 850;
  text-align: center;
  box-sizing: border-box;
}

.slot-available {
  background: #dcfce7;
  color: #067647;
}

.slot-disabled {
  background: #e2e8f0;
  color: #64748b;
}

.booking-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
  border-left: 6rpx solid #12b76a;
  background: #ecfdf3;
}

.summary-label,
.summary-status {
  display: block;
  color: #067647;
  font-size: 24rpx;
  font-weight: 750;
}

.summary-value {
  display: block;
  margin-top: 6rpx;
  color: #102016;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.summary-status {
  flex-shrink: 0;
  text-align: right;
}

.submit-button {
  position: sticky;
  bottom: 24rpx;
  z-index: 5;
  margin-top: 8rpx;
  margin-bottom: 16rpx;
  min-height: 92rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 44rpx rgba(18, 130, 79, 0.22);
}

.submit-button[disabled] {
  box-shadow: none;
}
