page {
  background: #0A0A0A;
}

.venue-page {
  min-height: 100vh;
  padding-bottom: 96px;
  background: #0A0A0A;
  color: #FFFFFF;
  box-sizing: border-box;
}

.top-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56px;
  padding: 0 16px;
  background: linear-gradient(90deg, #0D3B1E 0%, #1A5C3A 100%);
  box-sizing: border-box;
}

.back-link {
  position: relative;
  z-index: 1;
  width: 132px;
  color: #FFFFFF;
  font-size: 14px;
  line-height: 56px;
}

.venue-title {
  position: absolute;
  left: 50%;
  max-width: 220px;
  color: #FFFFFF;
  font-size: 16px;
  font-weight: 700;
  line-height: 56px;
  transform: translateX(-50%);
}

.top-spacer {
  width: 132px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  padding: 22px 16px 18px;
  gap: 10px;
  box-sizing: border-box;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 82px;
}

.stat-value {
  color: #C8FF00;
  font-size: 32px;
  font-weight: 700;
  line-height: 1.05;
}

.stat-label {
  margin-top: 8px;
  color: #FFFFFF;
  font-size: 12px;
  line-height: 1.2;
}

.schedule-section {
  padding: 0 16px;
}

.section-title {
  display: block;
  margin-bottom: 10px;
  color: #FFFFFF;
  font-size: 14px;
  line-height: 1.4;
}

.schedule-card {
  overflow: hidden;
  border-radius: 12px;
  background: #1A1A1A;
}

.schedule-row {
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr) 58px 42px;
  align-items: center;
  min-height: 60px;
  padding: 0 12px;
  border-bottom: 1px solid #333333;
  column-gap: 8px;
  box-sizing: border-box;
}

.schedule-row:last-child {
  border-bottom: 0;
}

.schedule-time,
.schedule-project,
.schedule-people {
  color: #FFFFFF;
  font-size: 13px;
  line-height: 1.3;
}

.schedule-project {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-project-wrap {
  min-width: 0;
}

.schedule-type {
  display: inline-block;
  margin-right: 5px;
  padding: 2px 4px;
  border-radius: 3px;
  color: #ffffff;
  font-size: 9px;
  font-weight: 700;
  vertical-align: middle;
}

.schedule-type-casual {
  background: #4a90d9;
}

.schedule-type-event {
  background: #ff9800;
}

.schedule-status {
  font-size: 12px;
  line-height: 1.3;
  text-align: center;
}

.status-confirmed {
  color: #4CAF50;
}

.status-pending {
  color: #FF9800;
}

.schedule-people {
  color: #999999;
  text-align: right;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  display: flex;
  gap: 12px;
  padding: 16px;
  background: #0A0A0A;
  box-sizing: border-box;
}

.action-button {
  flex: 1;
  height: 52px;
  border-radius: 12px;
  border: 0;
  font-size: 15px;
  font-weight: 700;
  line-height: 52px;
}

.action-button::after,
.order-button::after {
  border: 0;
}

.scan-button {
  background: #C8FF00;
  color: #000000;
}

.confirm-button {
  background: #1A5C3A;
  color: #C8FF00;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.62);
}

.confirm-sheet {
  width: 100%;
  max-height: 72vh;
  padding: 10px 16px 24px;
  border-radius: 18px 18px 0 0;
  background: #1A1A1A;
  box-sizing: border-box;
}

.sheet-handle {
  width: 40px;
  height: 4px;
  margin: 0 auto 14px;
  border-radius: 999px;
  background: #666666;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.sheet-title {
  color: #FFFFFF;
  font-size: 16px;
  font-weight: 700;
}

.sheet-close {
  color: #C8FF00;
  font-size: 13px;
}

.empty-orders {
  padding: 28px 0;
  color: #666666;
  font-size: 13px;
  text-align: center;
}

.order-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 68px;
  border-bottom: 1px solid #333333;
  gap: 10px;
}

.order-main {
  min-width: 0;
  flex: 1;
}

.order-title {
  display: block;
  color: #FFFFFF;
  font-size: 14px;
  font-weight: 700;
  line-height: 1.4;
}

.order-meta {
  display: block;
  margin-top: 4px;
  overflow: hidden;
  color: #999999;
  font-size: 12px;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-actions {
  display: flex;
  gap: 8px;
}

.order-button {
  width: 52px;
  height: 32px;
  padding: 0;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 700;
  line-height: 32px;
}

.approve {
  background: #C8FF00;
  color: #000000;
}

.reject {
  background: #333333;
  color: #FFFFFF;
}
