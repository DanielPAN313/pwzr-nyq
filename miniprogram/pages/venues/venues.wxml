<view class="page">
  <view class="venue-tabs">
    <view class="venue-tab-highlight venue-tab-{{venueMode}}"></view>
    <button
      wx:for="{{venueTabs}}"
      wx:key="mode"
      class="venue-tab {{venueMode === item.mode ? 'active' : ''}}"
      data-mode="{{item.mode}}"
      bindtap="switchVenueMode"
    >
      <text>{{item.label}}</text>
    </button>
  </view>

  <view class="venue-list {{venueMotionClass}}">
    <view wx:for="{{venues}}" wx:key="name" class="section venue-card">
      <view class="venue-visual">
        <view class="court-grid"></view>
        <text class="visual-tag">{{item.sportsText}}</text>
      </view>
      <view class="card-top">
        <view>
          <text class="card-title">{{item.name}}</text>
          <text class="muted">{{item.area}} · {{item.sportsText}} · {{item.distanceText}}</text>
        </view>
        <text class="rating">{{item.rating}}</text>
      </view>
      <view class="card-row">
        <view>
          <text class="price">¥{{item.price}}</text>
          <text class="muted">黄金时段优先锁场</text>
        </view>
        <button
          class="primary small"
          bindtap="bookVenue"
          data-id="{{item.id}}"
          disabled="{{bookingId === item.id}}"
        >
          {{bookingId === item.id ? "锁定中" : "订场"}}
        </button>
      </view>
    </view>
  </view>
</view>
