<view class="page">
  <view class="venue-tabs">
    <view class="venue-tab-highlight venue-tab-{{venueMode}}"></view>
    <button
      wx:for="{{venueTabs}}"
      wx:key="mode"
      class="venue-tab {{venueMode === item.mode ? 'active' : ''}}"
      data-mode="{{item.mode}}"
      bindtap="switchVenueMode"
    >
      <text>{{item.label}}</text>
    </button>
  </view>

  <view class="search-panel">
    <view class="search-dot"></view>
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜场馆 / 区域 / 足球"
      placeholder-class="search-placeholder"
      confirm-type="search"
      bindinput="onSearchInput"
    />
    <button wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">×</button>
  </view>

  <view class="result-line">
    <text>{{venues.length}} 个场馆可选</text>
    <text wx:if="{{keyword}}"> · 已筛选“{{keyword}}”</text>
  </view>

  <view class="venue-list {{venueMotionClass}}">
    <view wx:if="{{empty}}" class="section empty-card">
      <text class="card-title">没有找到匹配场馆</text>
      <text class="muted">换个区域、运动类型或场馆名试试。</text>
    </view>
    <view wx:for="{{venues}}" wx:key="name" class="section venue-card">
      <view class="venue-visual" bindtap="openVenueDetail" data-id="{{item.id}}">
        <view class="court-grid"></view>
        <view class="goal-box goal-left"></view>
        <view class="goal-box goal-right"></view>
      </view>
      <view class="card-top" bindtap="openVenueDetail" data-id="{{item.id}}">
        <view>
          <text class="venue-type">{{item.sportsText}}</text>
          <text class="card-title">{{item.name}}</text>
        </view>
        <text class="rating">{{item.rating}}</text>
      </view>
      <text class="venue-address">{{item.address}}</text>
      <view class="card-row">
        <text class="price">{{item.priceText}}</text>
        <button
          class="primary small book-action"
          bindtap="bookVenue"
          data-id="{{item.id}}"
          disabled="{{bookingId === item.id}}"
        >
          {{bookingId === item.id ? "锁定中" : "订场"}}
        </button>
      </view>
    </view>
  </view>
</view>
