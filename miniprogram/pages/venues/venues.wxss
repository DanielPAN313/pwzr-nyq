.venue-tabs {
  position: relative;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0;
  margin-bottom: 22rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(16, 27, 21, 0.92);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
  overflow: hidden;
}

.venue-tab-highlight {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  bottom: 8rpx;
  width: calc((100% - 16rpx) / 2);
  border-radius: 999rpx;
  background: #d8ff3e;
  transition: left 360ms cubic-bezier(0.18, 0.9, 0.22, 1), transform 360ms cubic-bezier(0.18, 0.9, 0.22, 1);
  will-change: left, transform;
}

.venue-tab-nearby {
  left: 8rpx;
}

.venue-tab-rating {
  left: 50%;
}

.venue-tab {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 66rpx;
  min-height: 66rpx;
  padding: 0;
  border-radius: 999rpx;
  color: rgba(247, 251, 245, 0.72);
  background: transparent;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 66rpx;
  letter-spacing: 0;
  text-align: center;
  box-sizing: border-box;
}

.venue-tab text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  line-height: 66rpx;
  text-align: center;
}

.venue-tab.active {
  color: #10200f;
}

.search-panel {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 84rpx;
  margin-bottom: 14rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(216, 255, 62, 0.14);
  border-radius: 999rpx;
  background: #101b15;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
  box-sizing: border-box;
}

.search-dot {
  width: 20rpx;
  height: 20rpx;
  border: 5rpx solid #d8ff3e;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  color: #f7fbf5;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.search-placeholder {
  color: rgba(247, 251, 245, 0.42);
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  min-height: 48rpx;
  border-radius: 50%;
  color: #10200f;
  background: #d8ff3e;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.result-line {
  min-height: 40rpx;
  margin: 0 8rpx 18rpx;
  color: rgba(247, 251, 245, 0.58);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.empty-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  border-style: dashed;
  background: #101b15;
}

.venue-list.venue-entering .venue-card {
  animation-name: rise-in;
  animation-duration: 420ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: both;
}

.venue-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  overflow: hidden;
  background: #101b15;
  border-radius: 30rpx;
  animation: rise-in 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.venue-card:nth-child(2) {
  animation-delay: 60ms;
}

.venue-card:nth-child(3) {
  animation-delay: 110ms;
}

.venue-visual {
  position: relative;
  height: 176rpx;
  margin: -8rpx -8rpx 0;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #0f8a4f, #15251b);
  overflow: hidden;
}

.court-grid {
  position: absolute;
  inset: 22rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.44);
}

.court-grid::before,
.court-grid::after {
  content: "";
  position: absolute;
  background: #d8ff3e;
}

.court-grid::before {
  left: 50%;
  top: 0;
  bottom: 0;
  width: 2rpx;
}

.court-grid::after {
  left: 0;
  right: 0;
  top: 50%;
  height: 2rpx;
}

.visual-tag {
  position: absolute;
  left: 22rpx;
  bottom: 18rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 22rpx;
  font-weight: 900;
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.rating {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 66rpx;
  height: 46rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 23rpx;
  font-weight: 900;
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
}

.card-row > view {
  flex: 1;
  min-width: 0;
}

.price {
  display: block;
  color: #d8ff3e;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: nowrap;
}

.small {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 154rpx;
  min-height: 72rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: #10200f;
  background: #d8ff3e;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 72rpx;
  text-align: center;
  box-sizing: border-box;
}

.book-action {
  min-width: 246rpx;
  min-height: 78rpx;
  font-size: 28rpx;
  line-height: 78rpx;
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(26rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
